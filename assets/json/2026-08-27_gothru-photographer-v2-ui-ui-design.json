      "main_description_html": "<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-4b0cd532-dbb2-4299-9e0f-7937488bb66c.png\"><img width=\"1311\" height=\"386\" alt=\"Image\" src=\"images/image-4b0cd532-dbb2-4299-9e0f-7937488bb66c.png\" style=\"max-width: 100%; height: auto; max-height: 386px;; aspect-ratio: 1311 / 386; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<h2 dir=\"auto\">RESULT</h2>\n<p dir=\"auto\">Branch: <code class=\"notranslate\">design/photographer-directory-role-expansion</code></p>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-493629b7-832d-4ac6-99d3-75b4d0841289.png\"><img width=\"1111\" height=\"2000\" alt=\"Image\" src=\"images/image-493629b7-832d-4ac6-99d3-75b4d0841289.png\" style=\"max-width: 100%; height: auto; max-height: 2000px;; aspect-ratio: 1111 / 2000; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-bf736eb0-c245-40bc-873d-ed0643351546.png\"><img width=\"1680\" height=\"1569\" alt=\"Image\" src=\"images/image-bf736eb0-c245-40bc-873d-ed0643351546.png\" style=\"max-width: 100%; height: auto; max-height: 1569px;; aspect-ratio: 1680 / 1569; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-e24128e7-04fd-4043-b772-f0b84c05e474.png\"><img width=\"1680\" height=\"1420\" alt=\"Image\" src=\"images/image-e24128e7-04fd-4043-b772-f0b84c05e474.png\" style=\"max-width: 100%; height: auto; max-height: 1420px;; aspect-ratio: 1680 / 1420; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-e8e0c46f-8ddd-4564-90a6-dbb3ce12e59a.png\"><img width=\"1681\" height=\"981\" alt=\"Image\" src=\"images/image-e8e0c46f-8ddd-45