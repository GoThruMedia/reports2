      "main_description_html": "<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-568d3f13-8411-4ce4-b3cf-7f54b51122e7.png\"><img width=\"1311\" height=\"386\" alt=\"Image\" src=\"images/image-568d3f13-8411-4ce4-b3cf-7f54b51122e7.png\" style=\"max-width: 100%; height: auto; max-height: 386px;; aspect-ratio: 1311 / 386; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<h2 dir=\"auto\">RESULT</h2>\n<p dir=\"auto\">Branch: <code class=\"notranslate\">design/photographer-directory-role-expansion</code></p>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-3ed31cb2-fa53-4eae-a3d4-aa840b796deb.png\"><img width=\"1111\" height=\"2000\" alt=\"Image\" src=\"images/image-3ed31cb2-fa53-4eae-a3d4-aa840b796deb.png\" style=\"max-width: 100%; height: auto; max-height: 2000px;; aspect-ratio: 1111 / 2000; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-d561d99e-4aa7-4eb3-a3ad-0c774f9486c9.png\"><img width=\"1680\" height=\"1569\" alt=\"Image\" src=\"images/image-d561d99e-4aa7-4eb3-a3ad-0c774f9486c9.png\" style=\"max-width: 100%; height: auto; max-height: 1569px;; aspect-ratio: 1680 / 1569; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-7eb8c584-94d1-4a8d-9507-2392f5f7d0e8.png\"><img width=\"1680\" height=\"1420\" alt=\"Image\" src=\"images/image-7eb8c584-94d1-4a8d-9507-2392f5f7d0e8.png\" style=\"max-width: 100%; height: auto; max-height: 1420px;; aspect-ratio: 1680 / 1420; background-color: var(--bgColor-muted); border-radius: 6px\" class=\"js-gh-image-fallback\"></a>\n<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"images/image-cc9f91e3-44d1-4b72-8032-d00abfda4a8d.png\"><img width=\"1681\" height=\"981\" alt=\"Image\" src=\"images/image-cc9f91e3-44d1-4b