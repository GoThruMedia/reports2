      "main_description_html": "<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Step 1 title — \"Where did you hear about Panorra?\"</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Step 1 desc — \"Help us understand how you discovered us.\"</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Step 2 title — \"What places interest you?\"</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Step 2 desc — \"Choose the types of places you'd like to discover in 360°.\"</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Step 3 title — \"How would you like to use Panorra?\"</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Step 3 desc — \"Tell us your goal so we can personalize your experience.\"</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Acquisition options — \"Social Media\", \"Friend or Family\", \"Search Engine\", \"Blog or Article\", \"Event or Community\", \"Other\"</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" id=\"\" disabled=\"\" class=\"task-list-item-checkbox\" aria-label=\"Incomplete task\"> Interest options — \"Attractions\", \"Nature &amp; Scenery\", \"History &amp; Heritage\", \"Culture &amp; Local Life\", \"Food &amp; Markets\", \"Hotels &amp; Stays\", \"Events &amp; Venues\", \"Architecture &amp; Unique Places\"</li>\n<li class=\"task-li