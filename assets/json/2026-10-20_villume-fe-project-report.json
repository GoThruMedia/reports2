      "main_description_html": "<p dir=\"auto\">Result BE</p>\n<ul dir=\"auto\">\n<li><a class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"5917191525\" data-permission-text=\"Title is private\" data-url=\"https://github.com/GoThruMedia/villume-backend-go/issues/221\" data-hovercard-type=\"issue\" data-hovercard-url=\"/GoThruMedia/villume-backend-go/issues/221/hovercard\" href=\"https://github.com/GoThruMedia/villume-backend-go/issues/221\">GoThruMedia/villume-backend-go#221</a></li>\n</ul>\n<hr>\n<h2 dir=\"auto\">API Example Usage</h2>\n<h3 dir=\"auto\">1. Using cURL</h3>\n<h4 dir=\"auto\">Request:</h4>\n<div class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"curl -X POST &quot;https://api-dev.villume.com/v1/auth/magic-link/request&quot; \\\n     -H &quot;Content-Type: application/json&quot; \\\n     -d '{\n       &quot;email&quot;: &quot;user@example.com&quot;\n     }'\"><pre class=\"notranslate\">curl -X POST <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>https://api-dev.villume.com/v1/auth/magic-link/request<span class=\"pl-pds\">\"</span></span> \\\n     -H <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Content-Type: application/json<span class=\"pl-pds\">\"</span></span> \\\n     -d <span class=\"pl-s\"><span class=\"pl-pds\">'</span>{</span>\n<span class=\"pl-s\">       \"email\": \"user@example.com\"</span>\n<span class=\"pl-s\">     }<span class=\"pl-pds\">'</span></span></pre></div>\n<h4 dir=\"auto\">Success Response (<code class=\"notranslate\">200 OK</code>):</h4>\n<div class=\"highlight highlight-source-json notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"{\n  &quot;statusCode&quot;: 200,\n  &quot;data&quot;: {\n    &quot;valid&quot;: true,\n    &quot;messages&quot;: &quot;If this email is registered, a magic login link has been sent.&quot;\n  }\n}\"><pre class=\"notranslate\">{\n  <span class=\"pl-ent\">\"statusCode\"</span>: <span class=\"pl-c1\">200</span>,\n  <span class=\"pl-ent\">\"data\"</span>: {\n    <span class=\"pl-ent\">\"valid\"</span>: <span class=\"pl-c1\">true</span>,\n    <span class=\"pl-ent\">\"messages\"</span>: <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>If this email is registered, a magic login link has been sent.<span class=\"pl-pds\">\"</span></span>\n  }\n}</pre></div>\n<h4 dir=\"auto\">Error: Unregistered Email (<code class=\"notranslate\">400 Bad Request</code>):</h4>\n<div class=\"highlight highlight-source-json notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"{\n  &quot;statusCode&quot;: 400,\n  &quot;data&quot;: {\n    &quot;messages&quot;: &quot;Register First&quot;,\n    &quot;valid&quot;: true,\n    &quot;code&quot;: &quot;unregistered&quot;\n  }\n}\"><pre class=\"notranslate\">{\n  <span class=\"pl-ent\">\"statusCode\"</span>: <span class=\"pl-c1\">400</span>,\n  <span class=\"pl-ent\">\"data\"</span>: {\n    <span class=\"pl-ent\">\"messages\"</span>: <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Register First<span class=\"pl-pds\">\"</span></span>,\n    <span class=\"pl-ent\">\"valid\"</span>: <span class=\"pl-c1\">true</span>,\n    <span class=\"pl-ent\">\"code\"</span>: <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>unregistered<span class=\"pl-pds\">\"</span></span>\n  }\n}</pre></div>\n<h4 dir=\"auto\">Error: Rate Limit Exceeded (<code class=\"notranslate\">429 Too Many Requests</code>):</h4>\n<div class=\"highlight highlight-source-json notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"{\n  &quot;statusCode&quot;: 429,\n  &quot;data&quot;: {\n    &quot;status&quot;: &quot;TOO_MANY_REQUESTS&quot;,\n    &quot;valid&quot;: false,\n    &quot;errors&quot;: {\n      &quot;messages&quot;: &quot;Too many magic link requests. Please wait a few minutes before trying again.&quot;\n    }\n  }\n}\"><pre class=\"notranslate\">{\n  <span class=\"pl-ent\">\"statusCode\"</span>: <span class=\"pl-c1\">429</span>,\n  <span class=\"pl-ent\">\"data\"</span>: {\n    <span class=\"pl-ent\">\"status\"</span>: <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>TOO_MANY_REQUESTS<span class=\"pl-pds\">\"</span></span>,\n    <span class=\"pl-ent\">\"valid\"</span>: <span class=\"pl-c1\">false</span>,\n    <span class=\"pl-ent\">\"errors\"</span>: {\n      <span class=\"pl-ent\">\"messages\"</span>: <span class=\"pl-s\"><span class=\"pl-pds\">\"</span>Too many magic link requests. Please wait a few minutes before trying again.<span class=\"pl-pds\">\"</span></span>\n    }\n  }\n}</pre></div>\n<hr>\n<h3 dir=\"auto\">2. Using TypeScript / Axios (Frontend Integration)</h3>\n<div class=\"highlight highlight-source-ts notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"import axios, { AxiosError } from 'axios';\n\ninterface RequestMagicLinkResponse {\n  statusCode: number;\n  data: {\n    valid: boolean;\n    messages: string;\n  };\n}\n\ninterface ErrorResponse {\n  statusCode: number;\n  data: {\n    code?: string;\n    messages?: string;\n    errors?: {\n      messages?: string;\n      input?: string;\n    };\n  };\n}\n\nexport async function requestEmergencyMagicLink(email: string): Promise&lt;string&gt; {\n  try {\n    const response = await axios.post&lt;RequestMagicLinkResponse&gt;(\n      `${process.env.NEXT_PUBLIC_API_URL}/v1/auth/magic-link/request`,\n      { email }\n    );\n\n    return response.data.data.messages;\n  } catch (err) {\n    const error = err as AxiosError&lt;ErrorResponse&gt;;\n    if (error.response) {\n      const { status, data } = error.response;\n\n      if (status === 400 &amp;&amp; data.data?.code === 'unregistered') {\n        throw new Error('This email is not registered yet. Please sign up first.');\n      }\n\n      if (status === 429) {\n        throw new Error(data.data?.errors?.messages || 'Too many attempts. Please wait 15 minutes.');\n      }\n\n      throw new Error(data.data?.errors?.messages || data.data?.messages || 'Failed to request magic link.');\n    }\n\n    throw new Error('Network error. Please check your internet connection.');\n  }\n}\"><pre class=\"notranslate\"><span class=\"pl-k\">import</span> <span class=\"pl-s1\">axios</span><span class=\"pl-kos\">,</span> <span class=\"pl-kos\">{</span> <span class=\"pl-v\">AxiosError</span> <span class=\"pl-kos\">}</span> <span class=\"pl-k\">from</span> <span class=\"pl-s\">'axios'</span><span class=\"pl-kos\">;</span>\n\n<span class=\"pl-k\">interface</span> <span class=\"pl-smi\">RequestMagicLinkResponse</span> <span class=\"pl-kos\">{</span>\n  <span class=\"pl-c1\">statusCode</span>: <span class=\"pl-smi\">number</span><span class=\"pl-kos\">;</span>\n  <span class=\"pl-c1\">data</span>: <span class=\"pl-kos\">{</span>\n    <span class=\"pl-c1\">valid</span>: <span class=\"pl-smi\">boolean</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-c1\">messages</span>: <span class=\"pl-smi\">string</span><span class=\"pl-kos\">;</span>\n  <span class=\"pl-kos\">}</span><span class=\"pl-kos\">;</span>\n<span class=\"pl-kos\">}</span>\n\n<span class=\"pl-k\">interface</span> <span class=\"pl-smi\">ErrorResponse</span> <span class=\"pl-kos\">{</span>\n  <span class=\"pl-c1\">statusCode</span>: <span class=\"pl-smi\">number</span><span class=\"pl-kos\">;</span>\n  <span class=\"pl-c1\">data</span>: <span class=\"pl-kos\">{</span>\n    <span class=\"pl-c1\">code</span>?: <span class=\"pl-smi\">string</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-c1\">messages</span>?: <span class=\"pl-smi\">string</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-c1\">errors</span>?: <span class=\"pl-kos\">{</span>\n      <span class=\"pl-c1\">messages</span>?: <span class=\"pl-smi\">string</span><span class=\"pl-kos\">;</span>\n      <span class=\"pl-c1\">input</span>?: <span class=\"pl-smi\">string</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-kos\">}</span><span class=\"pl-kos\">;</span>\n  <span class=\"pl-kos\">}</span><span class=\"pl-kos\">;</span>\n<span class=\"pl-kos\">}</span>\n\n<span class=\"pl-k\">export</span> <span class=\"pl-k\">async</span> <span class=\"pl-k\">function</span> <span class=\"pl-en\">requestEmergencyMagicLink</span><span class=\"pl-kos\">(</span><span class=\"pl-s1\">email</span>: <span class=\"pl-smi\">string</span><span class=\"pl-kos\">)</span>: <span class=\"pl-smi\">Promise</span><span class=\"pl-c1\">&lt;</span><span class=\"pl-smi\">string</span><span class=\"pl-c1\">&gt;</span> <span class=\"pl-kos\">{</span>\n  <span class=\"pl-k\">try</span> <span class=\"pl-kos\">{</span>\n    <span class=\"pl-k\">const</span> <span class=\"pl-s1\">response</span> <span class=\"pl-c1\">=</span> <span class=\"pl-k\">await</span> <span class=\"pl-s1\">axios</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">post</span><span class=\"pl-c1\">&lt;</span><span class=\"pl-smi\">RequestMagicLinkResponse</span><span class=\"pl-c1\">&gt;</span><span class=\"pl-kos\">(</span>\n      <span class=\"pl-s\">`<span class=\"pl-s1\"><span class=\"pl-kos\">${</span><span class=\"pl-s1\">process</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">env</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">NEXT_PUBLIC_API_URL</span><span class=\"pl-kos\">}</span></span>/v1/auth/magic-link/request`</span><span class=\"pl-kos\">,</span>\n      <span class=\"pl-kos\">{</span> email <span class=\"pl-kos\">}</span>\n    <span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n\n    <span class=\"pl-k\">return</span> <span class=\"pl-s1\">response</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">messages</span><span class=\"pl-kos\">;</span>\n  <span class=\"pl-kos\">}</span> <span class=\"pl-k\">catch</span> <span class=\"pl-kos\">(</span><span class=\"pl-s1\">err</span><span class=\"pl-kos\">)</span> <span class=\"pl-kos\">{</span>\n    <span class=\"pl-k\">const</span> <span class=\"pl-s1\">error</span> <span class=\"pl-c1\">=</span> <span class=\"pl-s1\">err</span> <span class=\"pl-k\">as</span> <span class=\"pl-smi\">AxiosError</span><span class=\"pl-c1\">&lt;</span><span class=\"pl-smi\">ErrorResponse</span><span class=\"pl-c1\">&gt;</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-k\">if</span> <span class=\"pl-kos\">(</span><span class=\"pl-s1\">error</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">response</span><span class=\"pl-kos\">)</span> <span class=\"pl-kos\">{</span>\n      <span class=\"pl-k\">const</span> <span class=\"pl-kos\">{</span> status<span class=\"pl-kos\">,</span> data <span class=\"pl-kos\">}</span> <span class=\"pl-c1\">=</span> <span class=\"pl-s1\">error</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">response</span><span class=\"pl-kos\">;</span>\n\n      <span class=\"pl-k\">if</span> <span class=\"pl-kos\">(</span><span class=\"pl-s1\">status</span> <span class=\"pl-c1\">===</span> <span class=\"pl-c1\">400</span> <span class=\"pl-c1\">&amp;&amp;</span> <span class=\"pl-s1\">data</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">code</span> <span class=\"pl-c1\">===</span> <span class=\"pl-s\">'unregistered'</span><span class=\"pl-kos\">)</span> <span class=\"pl-kos\">{</span>\n        <span class=\"pl-k\">throw</span> <span class=\"pl-k\">new</span> <span class=\"pl-v\">Error</span><span class=\"pl-kos\">(</span><span class=\"pl-s\">'This email is not registered yet. Please sign up first.'</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n      <span class=\"pl-kos\">}</span>\n\n      <span class=\"pl-k\">if</span> <span class=\"pl-kos\">(</span><span class=\"pl-s1\">status</span> <span class=\"pl-c1\">===</span> <span class=\"pl-c1\">429</span><span class=\"pl-kos\">)</span> <span class=\"pl-kos\">{</span>\n        <span class=\"pl-k\">throw</span> <span class=\"pl-k\">new</span> <span class=\"pl-v\">Error</span><span class=\"pl-kos\">(</span><span class=\"pl-s1\">data</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">errors</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">messages</span> <span class=\"pl-c1\">||</span> <span class=\"pl-s\">'Too many attempts. Please wait 15 minutes.'</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n      <span class=\"pl-kos\">}</span>\n\n      <span class=\"pl-k\">throw</span> <span class=\"pl-k\">new</span> <span class=\"pl-v\">Error</span><span class=\"pl-kos\">(</span><span class=\"pl-s1\">data</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">errors</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">messages</span> <span class=\"pl-c1\">||</span> <span class=\"pl-s1\">data</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">messages</span> <span class=\"pl-c1\">||</span> <span class=\"pl-s\">'Failed to request magic link.'</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-kos\">}</span>\n\n    <span class=\"pl-k\">throw</span> <span class=\"pl-k\">new</span> <span class=\"pl-v\">Error</span><span class=\"pl-kos\">(</span><span class=\"pl-s\">'Network error. Please check your internet connection.'</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n  <span class=\"pl-kos\">}</span>\n<span class=\"pl-kos\">}</span></pre></div>\n<hr>\n<h3 dir=\"auto\">3. Using Fetch API (JavaScript)</h3>\n<div class=\"highlight highlight-source-js notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"async function sendMagicLink(email) {\n  const response = await fetch('https://api-dev.villume.com/v1/auth/magic-link/request', {\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n    },\n    body: JSON.stringify({ email }),\n  });\n\n  const payload = await response.json();\n\n  if (!response.ok) {\n    if (response.status === 400 &amp;&amp; payload.data?.code === 'unregistered') {\n      alert('Email not found. Please register first.');\n      return;\n    }\n    alert(payload.data?.errors?.messages || payload.data?.messages || 'Error occurred');\n    return;\n  }\n\n  alert(payload.data.messages);\n}\"><pre class=\"notranslate\"><span class=\"pl-k\">async</span> <span class=\"pl-k\">function</span> <span class=\"pl-en\">sendMagicLink</span><span class=\"pl-kos\">(</span><span class=\"pl-s1\">email</span><span class=\"pl-kos\">)</span> <span class=\"pl-kos\">{</span>\n  <span class=\"pl-k\">const</span> <span class=\"pl-s1\">response</span> <span class=\"pl-c1\">=</span> <span class=\"pl-k\">await</span> <span class=\"pl-en\">fetch</span><span class=\"pl-kos\">(</span><span class=\"pl-s\">'https://api-dev.villume.com/v1/auth/magic-link/request'</span><span class=\"pl-kos\">,</span> <span class=\"pl-kos\">{</span>\n    <span class=\"pl-c1\">method</span>: <span class=\"pl-s\">'POST'</span><span class=\"pl-kos\">,</span>\n    <span class=\"pl-c1\">headers</span>: <span class=\"pl-kos\">{</span>\n      <span class=\"pl-s\">'Content-Type'</span>: <span class=\"pl-s\">'application/json'</span><span class=\"pl-kos\">,</span>\n    <span class=\"pl-kos\">}</span><span class=\"pl-kos\">,</span>\n    <span class=\"pl-c1\">body</span>: <span class=\"pl-c1\">JSON</span><span class=\"pl-kos\">.</span><span class=\"pl-en\">stringify</span><span class=\"pl-kos\">(</span><span class=\"pl-kos\">{</span> email <span class=\"pl-kos\">}</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">,</span>\n  <span class=\"pl-kos\">}</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n\n  <span class=\"pl-k\">const</span> <span class=\"pl-s1\">payload</span> <span class=\"pl-c1\">=</span> <span class=\"pl-k\">await</span> <span class=\"pl-s1\">response</span><span class=\"pl-kos\">.</span><span class=\"pl-en\">json</span><span class=\"pl-kos\">(</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n\n  <span class=\"pl-k\">if</span> <span class=\"pl-kos\">(</span><span class=\"pl-c1\">!</span><span class=\"pl-s1\">response</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">ok</span><span class=\"pl-kos\">)</span> <span class=\"pl-kos\">{</span>\n    <span class=\"pl-k\">if</span> <span class=\"pl-kos\">(</span><span class=\"pl-s1\">response</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">status</span> <span class=\"pl-c1\">===</span> <span class=\"pl-c1\">400</span> <span class=\"pl-c1\">&amp;&amp;</span> <span class=\"pl-s1\">payload</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">code</span> <span class=\"pl-c1\">===</span> <span class=\"pl-s\">'unregistered'</span><span class=\"pl-kos\">)</span> <span class=\"pl-kos\">{</span>\n      <span class=\"pl-en\">alert</span><span class=\"pl-kos\">(</span><span class=\"pl-s\">'Email not found. Please register first.'</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n      <span class=\"pl-k\">return</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-kos\">}</span>\n    <span class=\"pl-en\">alert</span><span class=\"pl-kos\">(</span><span class=\"pl-s1\">payload</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">errors</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">messages</span> <span class=\"pl-c1\">||</span> <span class=\"pl-s1\">payload</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">?.</span><span class=\"pl-c1\">messages</span> <span class=\"pl-c1\">||</span> <span class=\"pl-s\">'Error occurred'</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n    <span class=\"pl-k\">return</span><span class=\"pl-kos\">;</span>\n  <span class=\"pl-kos\">}</span>\n\n  <span class=\"pl-en\">alert</span><span class=\"pl-kos\">(</span><span class=\"pl-s1\">payload</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">data</span><span class=\"pl-kos\">.</span><span class=\"pl-c1\">messages</span><span class=\"pl-kos\">)</span><span class=\"pl-kos\">;</span>\n<span class=\"pl-kos\">}</span></pre></div>\n<hr>\n<h2 dir=\"auto\">Demo by Developer</h2>\n<p dir=\"auto\">Note: Local demo with mock data</p>\n<details open=\"\" class=\"details-reset border rounded-2\">\n  <summary class=\"tmp-px-3 py-2\">\n    <svg aria-hidden=\"true\" data-component=\"Octicon\" height=\"16\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" data-view-component=\"true\" class=\"octicon octicon-device-camera-video\">\n    <path d=\"M16 3.75v8.5a.75.75 0 0 1-1.136.643L11 10.575v.675A1.75 1.75 0 0 1 9.25 13h-7.5A1.75 1.75 0 0 1 0 11.25v-6.5C0 3.784.784 3 1.75 3h7.5c.966 0 1.75.784 1.75 1.75v.675l3.864-2.318A.75.75 0 0 1 16 3.75Zm-6.5 1a.25.25 0 0 0-.25-.25h-7.5a.25.25 0 0 0-.25.25v6.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-6.5ZM11 8.825l3.5 2.1v-5.85l-3.5 2.1Z\"></path>\n</svg>\n    <span class=\"m-1\">Screencast.From.2026-10-20.11-53-23.mp4</span>\n    <span class=\"dropdown-caret\"></span>\n  </summary>\n\n  <video src=\"videos/video-6262b51a-349c-4577-8b65-e0904990b08c.mp4\" data-canonical-src=\"videos/video-6262b51a-349c-4577-8b65-e0904990b08c.mp4\" controls=\"controls\" muted=\"muted\" class=\"d-block rounded-bottom-2 border-top width-fit\" style=\"max-height:640px; min-height: 200px\">\n\n  </video>\n</details>\n",
