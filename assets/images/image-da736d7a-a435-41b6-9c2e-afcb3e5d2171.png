<!DOCTYPE html>
    <html>    
        <head>
            <meta name='viewport' content='width=device-width' />
            <meta name='viewport' content='width=device-width, initial-scale=1'>
            <meta name='color-scheme' content='light dark'>
            <meta name='supported-color-schemes' content='light dark'>
            <title>Simple Transactional Email</title>
            <link rel='preconnect' href='https://fonts.googleapis.com'>
            <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
            <link href='https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&display=swap'
                rel='stylesheet'>
            <style>
                :root {
                    color-scheme: light dark;
                    supported-color-schemes: light dark;
                }
        
                html,
                body {
                    background-color: #f6f6f6;
                    font-family: Open Sans;
                    -webkit-font-smoothing: antialiased;
                    font-weight: 400;
                    font-size: 16px;
                    line-height: 24px;
                    margin: 0;
                    padding: 0;
                    -ms-text-size-adjust: 100%;
                    -webkit-text-size-adjust: 100%;
                    max-width: 100%;
                    color: #3A3A3A;
                }

                .logo-panorra {
                    width: 203px;
                    height: 100px;
                    margin: auto;
                    background-image: url('https://panorra.com/assets/images/logo.png');
                    background-size: contain;
                    background-repeat: no-repeat;
                    background-position: center;
                }
        
                p {
                    margin: 0;
                    margin-bottom: 16px;
                }
        
                table {
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    max-width: 600px;
                    margin: 0 auto;
                    border-collapse: collapse;
                    width: 100%;
                    font-family: 'Open Sans', sans-serif;
                }
        
                table td {
                    font-family: sans-serif;
                    font-size: 14px;
                    vertical-align: top;
                    text-align: center;
                }
        
                .wrapper {
                    background-color: #EBEBEC;
                }
        
                .description,
                .sub-footer,
                .tips-list,
                .wrap-btn-view {
                    background-color: #F7F6F9;
                }
        
                @media (prefers-color-scheme: dark) {
                    .logo-panorra {
                        background-image: url('https://panorra.com/assets/images/logo-dark.png');
                    }

                    .dark-svg {
                        fill: #ffffff;
                    }
        
                    .logo,
                    .placeholder-content,
                    .footer,
                    .table-information {
                        background-color: #121212;
                    }
        
                    .description,
                    .sub-footer,
                    .tips-list,
                    .wrap-btn-view {
                        background-color: #292433;
                    }
        
                    .table-information {
                        background-color: #362F42 !important;
                        border: solid 1px #292433 !important;
                    }
        
                    .title-information {
                        color: #FFFFFF;
                        background-color: #3F3F46 !important;
                    }
        
                    .table-information>tbody>tr>td {
                        color: #FFFFFF;
                    }
        
                    .description>p {
                        color: #FFFFFF;
                    }
        
                    .description>h3 {
                        color: #FFFFFF;
                    }
        
                    .description .code {
                        color: #FFFFFF;
                    }
        
                    .placeholder-content>h3 {
                        color: #FFFFFF;
                    }
        
                    .tips-list>h3 {
                        color: #FFFFFF;
                    }
        
                    .tips-list>p {
                        color: #FFFFFF;
                    }
        
                    .tips-list>ol>li {
                        color: #FFFFFF;
                    }
        
                    .footer>h3 {
                        color: #FFFFFF;
                    }
        
                    .footer>p {
                        color: #FFFFFF;
                    }
        
                    .sub-footer>P {
                        color: #FFFFFF;
                    }
        
                    .wrapper {
                        background-color: #221B2C;
                    }
        
                    .container {
                        background-color: #221B2C;
                    }
                }
        
        
                [data-ogsc] .wrapper {
                    background-color: #221B2C;
                }
        
                [data-ogsc] .logo-dark {
                    display: block !important;
                }
        
                [data-ogsc] .logo-light {
                    display: none !important;
                }
        
                @media only screen and (max-width: 620px) {
                    .container {
                        padding: 0px;
                    }
        
                    table {
                        margin-top: 0;
                    }
        
                    .description>p {
                        max-width: 100%;
                        font-size: 16px;
                    }
        
                    .footer>p {
                        max-width: 100%;
                        font-size: 16px;
                    }
                }
            </style>
        </head>
        
        <body>
            <table role='presentation' border='0' cellpadding='0' cellspacing='0' class='wrapper' style='
                    width: 100%; 
                    max-width: 100%;
                    min-height: 100vh;'>
                <tr>
                    <td class='container' style='
                            display: block;
                            margin: 0 auto !important;
                            max-width: 580px;
                            padding: 10px;
                            width: 580px; '>
                        <table role='presentation' border='0' cellpadding='0' cellspacing='0' class='main' style='
                                background: #ffffff;
                                border-radius: 3px;
                                width: 100%;'>
                            <tr>
                                <td class='logo' style='
                                        padding: 40px 0 20px;
                                        width: 100%;
                                        text-align: center;'>
                                    <div class="logo-panorra"></div>
                                </td>
                            </tr>
                            <tr>
                                <td class='placeholder-content' style='padding: 30px; text-align: center;'>
                                    <img src='https://panorra.com/assets/email-template/image/post-report-review.png' alt=''
                                        width='327' />
                                    <h3 style='
                                            font-weight: 700;
                                            font-size: 18px;
                                            line-height: 24px;
                                            margin: 0;
                                            margin-top: 25px;'>User Report Review</h3>
                                </td>
                            </tr>
                            <tr>
                                <td class='description' style='
                                        padding-bottom: 0; 
                                        padding: 20px 69px 0;
                                        text-align: left;'>
                                    <h3 style='margin-bottom: 10px; margin-top: 0;'>Hi {User Full Name}</h3>
                                    <p style='
                                        display: block;
                                        margin: 0 auto 16px;'>We want to inform you that your report has been reviewed. The User you reported has been {banned / mark as no violation} from Panorra.</p>
                                    
                                    <h3 class='title-information' style='
                                        background-color: #E7E7E7;
                                        margin-bottom: 0;
                                        padding: 8px;'>Report Detail</h3>
                                    <table class='table-information' style='
                                            text-align: left; 
                                            margin-bottom: 8px;
                                            border: solid 1px #E1DEE9;
                                            width: 100%;'>
                                        <tbody style='display: block;'>
                                            <tr>
                                                <td style='
                                                        font-weight: 600; 
                                                        min-width: 120px; 
                                                        text-align: left;
                                                        padding: 4px 8px;'>Reported</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>:</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>2024-02-07 07:29:26</td>
                                            </tr>
                                            <tr>
                                                <td style='
                                                        font-weight: 600; 
                                                        min-width: 120px;
                                                        text-align: left;
                                                        padding: 4px 8px;'>Category</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>:</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>Legal Issue</td>
                                            </tr>
                                            <tr>
                                                <td style='
                                                        font-weight: 600; 
                                                        min-width: 120px;
                                                        text-align: left;
                                                        padding: 4px 8px;'>Status</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>:</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>{Approved / Denied}</td>
                                            </tr>
                                            <tr>
                                                <td style='
                                                        font-weight: 600; 
                                                        min-width: 120px;
                                                        text-align: left;
                                                        padding: 4px 8px;'>Reason</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>:</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>Lorem Ipsum Dolor sit Amet</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
        
                            <tr>
                                <td class='tips-list' style='
                                        padding: 10px 69px 0px;
                                        padding-top: 5px; 
                                        text-align: left;'>
                                    <p>Here are the details of what you reported:</p>
                                </td>
                            </tr>

                            <tr>
                                <td class='description' style='
                                        padding-bottom: 0; 
                                        padding: 0px 69px 30px;
                                        text-align: left;'>
                                    <h3 class='title-information' style='
                                        background-color: #E7E7E7;
                                        margin-bottom: 0;
                                        margin-top: 0;
                                        padding: 8px;'>User Detail</h3>
                                    <table class='table-information' style='
                                            text-align: left; 
                                            margin-bottom: 15px;
                                            border: solid 1px #E1DEE9;
                                            width: 100%;'>
                                        <tbody style='display: block;'>
                                            <tr>
                                                <td style='
                                                        font-weight: 600; 
                                                        min-width: 120px; 
                                                        text-align: left;
                                                        padding: 4px 8px;'>Full Name</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>:</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>John Doe</td>
                                            </tr>
                                            <tr>
                                                <td style='
                                                        font-weight: 600; 
                                                        min-width: 120px;
                                                        text-align: left;
                                                        padding: 4px 8px;'>Username</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>:</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>@johndoe</td>
                                            </tr>
                                            <tr>
                                                <td style='
                                                        font-weight: 600; 
                                                        min-width: 120px;
                                                        text-align: left;
                                                        padding: 4px 8px;'>Status</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>:</td>
                                                <td style='
                                                        text-align: left;
                                                        padding: 4px 8px;'>{Banned / No Violation}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <p>Thank you for helping us maintain a safe and respectful community. If you have any questions or need further assistance, please don't hesitate to reach out at support@gothru.co</p>
                                </td>
                            </tr>

                            <tr>
                                <td class='footer' style='padding: 30px; text-align: center;'>
                                    <h3 style='
                                            font-weight: 700;
                                            font-size: 18px;
                                            line-height: 24px;
                                            margin: 0;
                                            margin-bottom: 8px;'>Get more from Panorra</h3>
                                    <p style='
                                            font-size: 14px;
                                            max-width: calc(100% - 120px);
                                            margin: 0 auto;
                                            display: block;
                                            margin-bottom: 0;'>Download our IOS and Android Native apps to make the most</p>
        
                                    <table class='link-derect'>
                                        <tbody style='
                                                display: flex;
                                                max-width: calc(100% - 130px);
                                                margin:  0 auto;'>
                                            <tr style='
                                                    flex: 1 1 auto;
                                                    margin: 0 6px;'>
                                                <td class='wrap-btn-derect' style='
                                                        background-color: transparent;
                                                        width: 100%;
                                                        text-align: center;
                                                        padding: 0;
                                                        padding-top: 30px;'>
                                                    <a href='https://play.google.com/store/apps/details?id=com.gothru.panorra'
                                                        class='btn-link-derect' style='
                                                            background-color: #292433;
                                                            color: #FFFFFF;
                                                            width: 135px;
                                                            height: 34px;
                                                            display: flex;
                                                            align-items: center;
                                                            text-decoration: none;
                                                            padding: 10px 24px;
                                                            border-radius: 3px;'>
                                                        <img src='https://panorra.com/assets/images/download-apps/download-play-store.png'
                                                            alt='' style='width: 100%;' />
                                                    </a>
                                                </td>
                                            </tr>
                                            <tr style='
                                                    flex: 1 1 auto;
                                                    margin: 0 6px;'>
                                                <td class='wrap-btn-derect' style='
                                                        background-color: transparent;
                                                        width: 100%;
                                                        text-align: center;
                                                        padding: 0;
                                                        padding-top: 30px;'>
                                                    <a href='https://apps.apple.com/ca/app/panorra/id1578823487'
                                                        class='btn-link-derect' style='
                                                            background-color: #292433;
                                                            color: #FFFFFF;
                                                            width: 135px;
                                                            height: 34px;
                                                            display: flex;
                                                            align-items: center;
                                                            text-decoration: none;
                                                            padding: 10px 24px;
                                                            border-radius: 3px;'>
                                                        <img src='https://panorra.com/assets/images/download-apps/download-app.png'
                                                            alt='' style='width: 100%;' />
                                                    </a>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td class='sub-footer' style='
                                        font-size: 14px;
                                        padding: 14px;
                                        text-align: center;'>
                                    <p style='margin-bottom: 0;'>2015-{{.Year}} @ All Rights Reserved | Gothru Media Inc.
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </body>
    </html>