- [ ] **Step 3: Implement the parser**

  Create `src/lib/tourmkr/pano.ts`:

  ```ts
  export interface TourmkrPanoRef {
    rawUrl: string;
    tourId: string;
    panoId: string;
    heading?: number;
    tilt?: number;
  }

  const ALLOWED_HOSTS = new Set(["tourmkr.com", "www.tourmkr.com"]);
  const PANO_SEGMENT_RE = /^(\d+)p(?:&(-?\d+(?:\.\d+)?)h)?(?:&(-?\d+(?:\.\d+)?)t)?$/;

  export function parseTourmkrPanoUrl(rawUrl: string): TourmkrPanoRef | null {
    const trimmed = rawUrl.trim();
    if (!trimmed) return null;

    let parsed: URL;
    try {
      parsed = new URL(trimmed);
    } catch {
      return null;
    }

    if (parsed.protocol !== "https:") return null;
    if (!ALLOWED_HOSTS.has(parsed.hostname.toLowerCase())) return null;
    if (parsed.search || parsed.hash) return null;

    const segments = parsed.pathname.split("/").filter(Boolean);
    if (segments.length !== 2) return null;

    const [tourId, panoSegment] = segments;
    if (!tourId) return null;

    const match = PANO_SEGMENT_RE.exec(panoSegment);
    if (!match) return null;

    const [, panoId, headingRaw, tiltRaw] = match;
    const heading = headingRaw === undefined ? undefined : Number(headingRaw);
    const tilt = tiltRaw === undefined ? undefined : Number(tiltRaw);

    if (headingRaw !== undefined && !Number.isFinite(heading)) return null;
    if (tiltRaw !== undefined && !Number.isFinite(tilt)) return null;

    return {
      rawUrl: trimmed,
      tourId,
      panoId,
      ...(heading !== undefined ? { heading } : {}),
      ...(tilt !== undefined ? { tilt } : {}),
    };
  }

  export function isTourmkrPanoUrl(rawUrl: string): boolean {
    return parseTourmkrPanoUrl(rawUrl) !== null;
  }
  ```

