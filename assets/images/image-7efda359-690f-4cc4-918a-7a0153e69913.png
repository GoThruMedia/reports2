## Task 4: Pano Overlay Modal

**Files:**
- Create: `src/components/editor/preview/PanoOverlayModal.tsx`

**Interfaces:**
- Consumes:
  ```ts
  TourmkrPanoRef
  title: string
  onClose: () => void
  ```
- Produces:
  ```tsx
  export default function PanoOverlayModal(props: {
    pano: TourmkrPanoRef;
    title: string;
    onClose: () => void;
  }): JSX.Element
  ```

- [ ] **Step 1: Create the modal component**

  Create `src/components/editor/preview/PanoOverlayModal.tsx`:

  ```tsx
  "use client";

  import { useEffect, useRef, useState } from "react";
  import { ExternalLink, Loader2, X } from "lucide-react";
  import type { TourmkrPanoRef } from "@/store/useMapStore";

  interface Props {
    pano: TourmkrPanoRef;
    title: string;
    onClose: () => void;
  }

  export default function PanoOverlayModal({ pano, title, onClose }: Props) {
    const [loading, setLoading] = useState(true);
    const [loadFailed, setLoadFailed] = useState(false);
    const closeButtonRef = useRef<HTMLButtonElement>(null);

    useEffect(() => {
      closeButtonRef.current?.focus();
    }, []);

    useEffect(() => {
      const handleKeyDown = (event: KeyboardEvent) => {
        if (event.key === "Escape") onClose();
      };
      window.addEventListener("keydown", handleKeyDown);
      return () => window.removeEventListener("keydown", handleKeyDown);
    }, [onClose]);

    return (
      <div
        className="fixed inset-0 z-[70] flex flex-col bg-black/80 p-3 backdrop-blur-sm sm:p-5"
        role="dialog"
        aria-modal="true"
        aria-label={`360 pano for ${title}`}
      >
        <div className="mb-3 flex items-center justify-between gap-3">
          <div className="min-w-0">
            <p className="truncate text-sm font-semibold text-white">{title}</p>
            <a
              href={pano.rawUrl}
              target="_blank"
              rel="noopener noreferrer"
              className="mt-1 inline-flex items-center gap-1 text-xs text-white/70 underline"
            >
              Open pano in TourMkr
              <ExternalLink className="size-3" />
            </a>
          </div>
          <button
            ref={closeButtonRef}
            type="button"
            onClick={onClose}
            aria-label="Close pano"
            className="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-white text-black transition-colors hover:bg-white/90"
          >
            <X className="size-5" />
          </button>
        </div>

        <div className="relative min-h-0 flex-1 overflow-hidden rounded-[14px] bg-black shadow-2xl">
          {loading && (
            <div className="absolute inset-0 z-10 flex items-center justify-center bg-black text-sm text-white/80">
              <Loader2 className="mr-2 size-4 animate-spin" />
              Loading pano
            </div>
          )}

          {loadFailed && (
            <div className="absolute inset-0 z-20 flex flex-col items-center justify-center gap-3 bg-black px-6 text-center text-sm text-white">
              <p>TourMkr could not be loaded inside the modal.</p>
              <a
                href={pano.rawUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="inline-flex h-9 items-center gap-2 rounded-[10px] bg-white px-4 text-sm font-medium text-black"
              >
                Open pano in TourMkr
                <ExternalLink className="size-4" />
              </a>
            </div>
          )}

          <iframe
            src={pano.rawUrl}
            title={`360 pano for ${title}`}
            className="h-full w-full border-0"
            allow="fullscreen; autoplay; xr-spatial-tracking; gyroscope; accelerometer"
            allowFullScreen
            onLoad={() => setLoading(false)}
            onError={() => {
              setLoading(false);
              setLoadFailed(true);
            }}
          />
        </div>
      </div>
    );
  }
  ```

  Do not add an iframe `sandbox` attribute in v1. TourMkr viewer behavior is unknown, and sandbox can break cross-origin viewer scripts; the modal still uses a top-level external fallback link.

