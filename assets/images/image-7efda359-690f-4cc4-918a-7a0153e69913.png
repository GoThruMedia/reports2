  import { describe, expect, it } from "vitest";
  import { isTourmkrPanoUrl, parseTourmkrPanoUrl } from "../pano";

  describe("parseTourmkrPanoUrl", () => {
    it("parses a TourMkr pano URL with tour id and pano id", () => {
      expect(parseTourmkrPanoUrl("https://tourmkr.com/F1gvbw5zEr/5525144p")).toEqual({
        rawUrl: "https://tourmkr.com/F1gvbw5zEr/5525144p",
        tourId: "F1gvbw5zEr",
        panoId: "5525144",
      });
    });

    it("parses heading and tilt parameters from the pano path segment", () => {
      expect(parseTourmkrPanoUrl("https://tourmkr.com/F1gvbw5zEr/5525144p&29.76h&87.45t")).toEqual({
        rawUrl: "https://tourmkr.com/F1gvbw5zEr/5525144p&29.76h&87.45t",
        tourId: "F1gvbw5zEr",
        panoId: "5525144",
        heading: 29.76,
        tilt: 87.45,
      });
    });

    it("accepts www.tourmkr.com", () => {
      expect(parseTourmkrPanoUrl("https://www.tourmkr.com/F1gvbw5zEr/5525144p")).toMatchObject({
        tourId: "F1gvbw5zEr",
        panoId: "5525144",
      });
    });

    it("trims surrounding whitespace but preserves the normalized raw URL", () => {
      expect(parseTourmkrPanoUrl("  https://tourmkr.com/F1gvbw5zEr/5525144p  ")?.rawUrl).toBe(
        "https://tourmkr.com/F1gvbw5zEr/5525144p"
      );
    });

    it.each([
      "http://tourmkr.com/F1gvbw5zEr/5525144p",
      "https://example.com/F1gvbw5zEr/5525144p",
      "https://tourmkr.com/F1gvbw5zEr",
      "https://tourmkr.com/F1gvbw5zEr/not-a-pano",
      "https://tourmkr.com/F1gvbw5zEr/5525144",
      "https://tourmkr.com/F1gvbw5zEr/5525144p&headingh&87.45t",
      "https://tourmkr.com/F1gvbw5zEr/5525144p&29.76h&tiltt",
      "https://tourmkr.com/F1gvbw5zEr/5525144p&29.76h&87.45t&extra",
    ])("rejects invalid URL %s", (url) => {
      expect(parseTourmkrPanoUrl(url)).toBeNull();
      expect(isTourmkrPanoUrl(url)).toBe(false);
    });

    it("returns true for valid TourMkr pano URLs", () => {
      expect(isTourmkrPanoUrl("https://tourmkr.com/F1gvbw5zEr/5525144p")).toBe(true);
      expect(isTourmkrPanoUrl("https://tourmkr.com/F1gvbw5zEr/5525144p&29.76h&87.45t")).toBe(true);
    });
  });
  ```

