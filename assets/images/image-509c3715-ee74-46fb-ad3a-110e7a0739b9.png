## Task 2: Auth Server Actions

**Files:**
- Create: `src/actions/auth.ts`

**Interfaces:**
- Consumes: `auth`, `signIn`, `signOut` from `@/auth`; `GOTHRU_API_URL` env var
- Produces:
  - `loginAction(email, password) → {success:true} | {error:string}`
  - `registerAction(fullName, email, password) → {success:true} | {error:string}`
  - `verifyEmailAction(token) → {verified:true} | {error:string}`
  - `resendVerificationAction() → {sent:true} | {error:string}`
  - `forgotPasswordAction(email) → {sent:true}`
  - `validateResetTokenAction(token) → {valid:true} | {error:string}`
  - `resetPasswordAction(token, newPassword) → {success:true} | {error:string}`
  - `logoutAction() → void`

- [ ] **Step 1: Create `src/actions/auth.ts`**

```typescript
"use server"

import { auth, signIn, signOut } from "@/auth"
import { AuthError } from "next-auth"

const API = process.env.GOTHRU_API_URL!

export async function loginAction(email: string, password: string) {
  try {
    await signIn("credentials", { email, password, redirect: false })
    return { success: true } as const
  } catch (err) {
    if (err instanceof AuthError) {
      if (err.message?.includes("EMAIL_NOT_VERIFIED")) {
        return { error: "EMAIL_NOT_VERIFIED" } as const
      }
      return { error: "Invalid email or password" } as const
    }
    return { error: "Login failed. Please try again." } as const
  }
}

export async function registerAction(
  fullName: string,
  email: string,
  password: string,
) {
  const res = await fetch(`${API}/v1/auth/register`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ fullName, email, password }),
  })
  const data = await res.json()
  if (!res.ok) return { error: data.error ?? "Registration failed" } as const
  try {
    await signIn("credentials", { email, password, redirect: false })
  } catch {
    // Non-fatal — user can log in manually
  }
  return { success: true } as const
}

export async function verifyEmailAction(token: string) {
  const res = await fetch(
    `${API}/v1/auth/verify-email?token=${encodeURIComponent(token)}`,
  )
  const data = await res.json()
  if (!res.ok) return { error: data.error ?? "INVALID_OR_EXPIRED_TOKEN" } as const
  return { verified: true } as const
}

export async function resendVerificationAction() {
  const session = await auth()
  if (!session?.accessToken) return { error: "Not authenticated" } as const
  const res = await fetch(`${API}/v1/auth/resend-verification`, {
    method: "POST",
    headers: { Authorization: `Bearer ${session.accessToken}` },
  })
  if (res.status === 429) return { error: "TOO_MANY_REQUESTS" } as const
  if (!res.ok) return { error: "Failed to resend" } as const
  return { sent: true } as const
}

export async function forgotPasswordAction(email: string) {
  await fetch(`${API}/v1/auth/forgot-password`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email }),
  })
  // Always return success — Go never reveals if email exists
  return { sent: true } as const
}

export async function validateResetTokenAction(token: string) {
  const res = await fetch(
    `${API}/v1/auth/validate-reset-token?token=${encodeURIComponent(token)}`,
  )
  const data = await res.json()
  if (!res.ok) return { error: data.error ?? "INVALID_OR_EXPIRED_TOKEN" } as const
  return { valid: true } as const
}

export async function resetPasswordAction(token: string, newPassword: string) {
  const res = await fetch(`${API}/v1/auth/reset-password`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ token, newPassword }),
  })
  const data = await res.json()
  if (!res.ok) return { error: data.error ?? "Reset failed" } as const
  return { success: true } as const
}

export async function logoutAction() {
  await signOut({ redirect: false })
}
```

