## Task 15: Billing Pages

**Files:**
- Create: `src/app/billing/page.tsx`
- Create: `src/app/billing/success/page.tsx`
- Create: `src/app/billing/cancel/page.tsx`

**Interfaces:**
- Consumes: `createCheckoutSession`, `createBillingPortalSession`, `getBillingStatus` from `@/actions/billing`
- Stripe redirects to `NEXT_PUBLIC_APP_URL/billing/success?session_id={CHECKOUT_SESSION_ID}` on success
- Stripe redirects to `NEXT_PUBLIC_APP_URL/billing/cancel` when user cancels

- [ ] **Step 1: Create `src/app/billing/page.tsx`**

```typescript
"use client"

import { useEffect, useState } from "react"
import {
  getBillingStatus,
  createCheckoutSession,
  createBillingPortalSession,
} from "@/actions/billing"

type BillingStatus = "loading" | "active" | "inactive" | "past_due" | "canceled"

export default function BillingPage() {
  const [status, setStatus] = useState<BillingStatus>("loading")
  const [periodEnd, setPeriodEnd] = useState<string | null>(null)
  const [working, setWorking] = useState(false)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    getBillingStatus().then((data) => {
      setStatus(data.status)
      setPeriodEnd(data.currentPeriodEnd)
    })
  }, [])

  async function handleSubscribe() {
    setWorking(true)
    setError(null)
    const result = await createCheckoutSession()
    if ("url" in result) {
      window.location.href = result.url
    } else {
      setError(result.error)
      setWorking(false)
    }
  }

  async function handleManage() {
    setWorking(true)
    setError(null)
    const result = await createBillingPortalSession()
    if ("url" in result) {
      window.location.href = result.url
    } else {
      setError(result.error)
      setWorking(false)
    }
  }

  if (status === "loading") return <div>Loading billing status…</div>

  return (
    <div>
      <h1>Billing</h1>
      {error && <p style={{ color: "red" }}>{error}</p>}
      {status === "active" ? (
        <div>
          <p>Your subscription is active.</p>
          {periodEnd && (
            <p>Renews on {new Date(periodEnd).toLocaleDateString()}</p>
          )}
          <button onClick={handleManage} disabled={working}>
            {working ? "Loading…" : "Manage subscription"}
          </button>
        </div>
      ) : (
        <div>
          <p>
            {status === "past_due"
              ? "Your subscription payment is past due."
              : status === "canceled"
                ? "Your subscription has been canceled."
                : "You don't have an active subscription."}
          </p>
          <button onClick={handleSubscribe} disabled={working}>
            {working ? "Loading…" : "Subscribe"}
          </button>
        </div>
      )}
    </div>
  )
}
```

