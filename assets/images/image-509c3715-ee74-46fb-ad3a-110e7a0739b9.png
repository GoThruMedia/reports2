## Task 14: Billing Server Actions

**Files:**
- Create: `src/actions/billing.ts`

**Interfaces:**
- Consumes: `auth` from `@/auth`; `GOTHRU_API_URL` env var
- Produces:
  - `createCheckoutSession(): Promise<{url: string} | {error: string}>` — calls `POST /v1/billing/checkout`
  - `createBillingPortalSession(): Promise<{url: string} | {error: string}>` — calls `POST /v1/billing/portal`
  - `getBillingStatus(): Promise<{status: 'active'|'inactive'|'past_due'|'canceled', currentPeriodEnd: string|null}>` — calls `GET /v1/billing/status`

- [ ] **Step 1: Create `src/actions/billing.ts`**

```typescript
"use server"

import { auth } from "@/auth"

const API = process.env.GOTHRU_API_URL!

export async function createCheckoutSession(): Promise<
  { url: string } | { error: string }
> {
  const session = await auth()
  if (!session?.accessToken) return { error: "Not authenticated" }
  const res = await fetch(`${API}/v1/billing/checkout`, {
    method: "POST",
    headers: { Authorization: `Bearer ${session.accessToken}` },
  })
  if (!res.ok) {
    const err = await res.json().catch(() => ({}))
    return { error: (err as { error?: string }).error ?? "Failed to create checkout session" }
  }
  return res.json()
}

export async function createBillingPortalSession(): Promise<
  { url: string } | { error: string }
> {
  const session = await auth()
  if (!session?.accessToken) return { error: "Not authenticated" }
  const res = await fetch(`${API}/v1/billing/portal`, {
    method: "POST",
    headers: { Authorization: `Bearer ${session.accessToken}` },
  })
  if (!res.ok) {
    const err = await res.json().catch(() => ({}))
    return { error: (err as { error?: string }).error ?? "Failed to open billing portal" }
  }
  return res.json()
}

export async function getBillingStatus(): Promise<{
  status: "active" | "inactive" | "past_due" | "canceled"
  currentPeriodEnd: string | null
}> {
  const session = await auth()
  if (!session?.accessToken) return { status: "inactive", currentPeriodEnd: null }
  const res = await fetch(`${API}/v1/billing/status`, {
    headers: { Authorization: `Bearer ${session.accessToken}` },
    cache: "no-store",
  })
  if (!res.ok) return { status: "inactive", currentPeriodEnd: null }
  return res.json()
}
```

