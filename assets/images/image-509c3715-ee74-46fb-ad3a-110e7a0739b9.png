import { listProjects, updateProject, deleteProject, getMeAction } from "@/actions/projects"
import { resendVerificationAction, logoutAction } from "@/actions/auth"
import { useSession } from "next-auth/react"

const { data: session } = useSession()

// Loading data:
useEffect(() => {
  Promise.all([getMeAction(), listProjects()])
    .then(([me, { projects }]) => {
      setUser(me)
      setProjects(projects)
    })
    .catch(() => router.push("/login"))
    .finally(() => setLoading(false))
}, [router])

// Rename:
async function handleRename(id: string, name: string) {
  await updateProject(id, { name })
  setProjects((prev) =>
    prev.map((p) => (p.id === id ? { ...p, name } : p)),
  )
}

// Delete:
async function handleDelete(id: string) {
  await deleteProject(id)
  setProjects((prev) => prev.filter((p) => p.id !== id))
}

// Resend verification banner — shown when !session?.user?.emailVerified:
async function handleResend() {
  setResendStatus("sending")
  const result = await resendVerificationAction()
  setResendStatus("error" in result ? "error" : "sent")
}

// Logout:
async function handleLogout() {
  localStorage.removeItem("gf_project_id")
  await logoutAction()
  router.push("/login")
}
