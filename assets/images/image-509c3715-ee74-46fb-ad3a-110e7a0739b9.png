```typescript
import { updateProject } from "@/actions/projects"

// Manual save button:
async function handleSave() {
  const id = store.projectId
  if (!id) return
  store.setSaving(true)
  try {
    await updateProject(id, {
      canvasData: JSON.stringify(store.canvasData),
      status: "edited",
    })
    store.setLastSavedAt(new Date())
  } finally {
    store.setSaving(false)
  }
}

// Auto-save (debounced 2s after canvas change):
const debouncedSave = useCallback(
  debounce(async (id: string, canvasData: unknown) => {
    try {
      await updateProject(id, { canvasData: JSON.stringify(canvasData) })
      store.setLastSavedAt(new Date())
    } catch {
      // Fallback to localStorage on network failure
      if (typeof window !== "undefined") {
        localStorage.setItem("gf_canvas_fallback", JSON.stringify(canvasData))
      }
    }
  }, 2000),
  [],
)

useEffect(() => {
  if (store.projectId && store.canvasData) {
    debouncedSave(store.projectId, store.canvasData)
  }
}, [store.canvasData, store.projectId, debouncedSave])

// In JSX:
{store.isSaving && <span>Saving…</span>}
{!store.isSaving && store.lastSavedAt && (
  <span>Saved {timeAgo(store.lastSavedAt)}</span>
)}
```

