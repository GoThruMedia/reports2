## Task 3: Project Server Actions

**Files:**
- Create: `src/actions/projects.ts`

**Interfaces:**
- Consumes: `auth` from `@/auth`; `revalidatePath` from `next/cache`; `GOTHRU_API_URL` env var
- Produces:
  - `listProjects() → {projects: Project[]}`
  - `createProject(data) → {id, name, status}`
  - `getProject(id) → Project`
  - `updateProject(id, data) → {id, status}`
  - `deleteProject(id) → void`
  - `publishProject(id) → {id, status}`
  - `unpublishProject(id) → {id, status}`
  - `getMeAction() → {userId, email, name, emailVerified}`
  - `deleteFileAction(name, projectId) → void`

- [ ] **Step 1: Create `src/actions/projects.ts`**

```typescript
"use server"

import { auth } from "@/auth"
import { revalidatePath } from "next/cache"

const API = process.env.GOTHRU_API_URL!

export type Project = {
  id: string
  name: string
  status: "draft" | "scanned" | "edited" | "published" | "unpublished"
  location_address?: string | null
  location_lat?: number | null
  location_lng?: number | null
  floor_configs?: string | null
  generated_twin?: string | null
  canvas_data?: string | null
  updated_at: string
}

async function getToken(): Promise<string> {
  const session = await auth()
  if (!session?.accessToken) throw new Error("Not authenticated")
  return session.accessToken
}

export async function listProjects(): Promise<{ projects: Project[] }> {
  const token = await getToken()
  const res = await fetch(`${API}/v1/projects`, {
    headers: { Authorization: `Bearer ${token}` },
    cache: "no-store",
  })
  if (!res.ok) throw new Error("Failed to fetch projects")
  return res.json()
}

export async function createProject(data: {
  name?: string
  locationAddress?: string
  locationLat?: number
  locationLng?: number
}): Promise<{ id: string; name: string; status: string }> {
  const token = await getToken()
  const res = await fetch(`${API}/v1/projects`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${token}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify(data),
  })
  if (!res.ok) {
    const err = await res.json()
    throw new Error(err.error ?? "Failed to create project")
  }
  revalidatePath("/dashboard")
  return res.json()
}

export async function getProject(id: string): Promise<Project> {
  const token = await getToken()
  const res = await fetch(`${API}/v1/projects/${id}`, {
    headers: { Authorization: `Bearer ${token}` },
    cache: "no-store",
  })
  if (!res.ok) throw new Error("Project not found")
  return res.json()
}

export async function updateProject(
  id: string,
  data: {
    name?: string
    floorConfigs?: string
    generatedTwin?: string
    canvasData?: string
    status?: string
  },
): Promise<{ id: string; status: string }> {
  const token = await getToken()
  const res = await fetch(`${API}/v1/projects/${id}`, {
    method: "PATCH",
    headers: {
      Authorization: `Bearer ${token}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify(data),
  })
  if (!res.ok) {
    const err = await res.json()
    throw new Error(err.error ?? "Failed to update project")
  }
  revalidatePath("/dashboard")
  return res.json()
}

export async function deleteProject(id: string): Promise<void> {
  const token = await getToken()
  await fetch(`${API}/v1/projects/${id}`, {
    method: "DELETE",
    headers: { Authorization: `Bearer ${token}` },
  })
  revalidatePath("/dashboard")
}

export async function publishProject(
  id: string,
): Promise<{ id: string; status: string }> {
  const token = await getToken()
  const res = await fetch(`${API}/v1/projects/${id}/publish`, {
    method: "POST",
    headers: { Authorization: `Bearer ${token}` },
  })
  if (!res.ok) {
    const err = await res.json()
    throw new Error(err.error ?? "Failed to publish")
  }
  revalidatePath("/dashboard")
  return res.json()
}

export async function unpublishProject(
  id: string,
): Promise<{ id: string; status: string }> {
  const token = await getToken()
  const res = await fetch(`${API}/v1/projects/${id}/unpublish`, {
    method: "POST",
    headers: { Authorization: `Bearer ${token}` },
  })
  if (!res.ok) {
    const err = await res.json()
    throw new Error(err.error ?? "Failed to unpublish")
  }
  revalidatePath("/dashboard")
  return res.json()
}

export async function getMeAction(): Promise<{
  userId: string
  email: string
  name: string
  emailVerified: boolean
}> {
  const token = await getToken()
  const res = await fetch(`${API}/v1/auth/me`, {
    headers: { Authorization: `Bearer ${token}` },
    cache: "no-store",
  })
  if (!res.ok) throw new Error("Not authenticated")
  return res.json()
}

export async function deleteFileAction(
  name: string,
  projectId: string,
): Promise<void> {
  const token = await getToken()
  await fetch(
    `${API}/v1/files?name=${encodeURIComponent(name)}&projectId=${encodeURIComponent(projectId)}`,
    {
      method: "DELETE",
      headers: { Authorization: `Bearer ${token}` },
    },
  )
}
```

