## Task 5: File Upload Route Handler

**Files:**
- Create: `src/app/api/upload/route.ts`

**Interfaces:**
- Consumes: `auth` from `@/auth`; `GOTHRU_API_URL` env var
- Browser sends `POST /api/upload` with multipart `file` + `projectId` fields
- Route Handler adds `Authorization: Bearer` and forwards to Go `/v1/upload`
- No `Content-Type` header set manually — Node's FormData sets the multipart boundary

- [ ] **Step 1: Create `src/app/api/upload/route.ts`**

```typescript
import { NextRequest, NextResponse } from "next/server"
import { auth } from "@/auth"

export async function POST(req: NextRequest) {
  const session = await auth()
  if (!session?.accessToken) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
  }

  const formData = await req.formData()
  const file = formData.get("file") as File | null
  const projectId = formData.get("projectId") as string | null

  if (!file || !projectId) {
    return NextResponse.json(
      { error: "file and projectId are required" },
      { status: 400 },
    )
  }

  const form = new FormData()
  form.append("file", file)
  form.append("projectId", projectId)

  const res = await fetch(`${process.env.GOTHRU_API_URL}/v1/upload`, {
    method: "POST",
    headers: { Authorization: `Bearer ${session.accessToken}` },
    body: form,
  })

  if (!res.ok) {
    const error = await res.json().catch(() => ({ error: "Upload failed" }))
    return NextResponse.json(error, { status: res.status })
  }

  return NextResponse.json(await res.json())
}
```

