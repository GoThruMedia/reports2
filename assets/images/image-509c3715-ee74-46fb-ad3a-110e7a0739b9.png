```typescript
import { createProject, updateProject, getProject } from "@/actions/projects"

// Step 1 confirmed → create project:
async function handleStep1Confirmed(data: {
  name: string
  locationAddress?: string
  locationLat?: number
  locationLng?: number
}) {
  const project = await createProject(data)
  store.setProjectId(project.id) // also writes to localStorage via store action
}

// Step 3 → Step 4 transition → save floor configs:
async function handleFloorConfigsSaved(floorConfigs: string) {
  const id = store.projectId
  if (!id) return
  await updateProject(id, { floorConfigs })
}

// Step 4 scan success → save AI output:
async function handleScanSuccess(generatedTwin: string) {
  const id = store.projectId
  if (!id) return
  await updateProject(id, { generatedTwin, status: "scanned" })
}

// Page load → restore from DB:
useEffect(() => {
  const savedId = typeof window !== "undefined"
    ? localStorage.getItem("gf_project_id")
    : null
  if (!savedId) return
  getProject(savedId)
    .then((project) => {
      store.setProjectId(project.id)
      store.restoreFromProject(project)
    })
    .catch(() => {
      if (typeof window !== "undefined") localStorage.removeItem("gf_project_id")
    })
}, [])
```

- [ ] **Step 2: Update file upload call (keep as browser fetch — not a Server Action)**

```typescript
// File upload — browser fetch to Next.js Route Handler (NOT a Server Action):
async function uploadFile(file: File, projectId: string) {
  const form = new FormData()
  form.append("file", file)
  form.append("projectId", projectId)
  // No Content-Type header — browser sets multipart boundary automatically
  const res = await fetch("/api/upload", { method: "POST", body: form })
  if (!res.ok) {
    const err = await res.json().catch(() => ({ error: "Upload failed" }))
    throw new Error(err.error)
  }
  return res.json() as Promise<{ path: string }>
}
```

