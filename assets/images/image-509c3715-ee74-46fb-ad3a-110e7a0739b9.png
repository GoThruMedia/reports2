## Task 4: Middleware (NextAuth-based)

**Files:**
- Modify: `src/middleware.ts`

**Interfaces:**
- Consumes: `auth` from `@/auth`
- Behavior:
  - Unauthenticated → redirect to `/login?from=<pathname>`
  - Authenticated but `!emailVerified` on `/start/*` or `/editor/*` → redirect to `/verify-email-pending`
  - `/dashboard` accessible without `emailVerified` (user can resend from there)

- [ ] **Step 1: Replace `src/middleware.ts`**

Read the existing file first, then overwrite with:

```typescript
import { auth } from "@/auth"
import { NextResponse } from "next/server"

export default auth((req) => {
  const session = req.auth
  const { pathname } = req.nextUrl

  if (!session) {
    const loginUrl = new URL(
      `/login?from=${encodeURIComponent(pathname)}`,
      req.url,
    )
    return NextResponse.redirect(loginUrl)
  }

  const emailGatedPaths = ["/start", "/editor"]
  if (emailGatedPaths.some((p) => pathname.startsWith(p))) {
    if (!session.user?.emailVerified) {
      return NextResponse.redirect(
        new URL("/verify-email-pending", req.url),
      )
    }
  }

  return NextResponse.next()
})

export const config = {
  matcher: ["/start/:path*", "/editor/:path*", "/dashboard/:path*"],
}
```

