- [ ] **Step 3: Update `src/app/(auth)/verify-email-pending/page.tsx`**

```typescript
import { resendVerificationAction, logoutAction } from "@/actions/auth"
import { getMeAction } from "@/actions/projects"

// On mount — get masked email:
useEffect(() => {
  getMeAction()
    .then((data) => setMaskedEmail(maskEmail(data.email)))
    .catch(() => {})
}, [])

// Resend handler:
async function handleResend() {
  setStatus("sending")
  const result = await resendVerificationAction()
  if ("error" in result && result.error === "TOO_MANY_REQUESTS") {
    setStatus("rate-limited")
    startCooldown(60)
    return
  }
  setStatus("sent")
  startCooldown(30)
}

// Sign out handler:
async function handleSignOut() {
  await logoutAction()
  router.push("/register")
}
```

### 6d: Verify-email page

The verify-email page must call `session.update()` after verification so NextAuth re-fetches `emailVerified` from Go, updating the encrypted session cookie. This triggers the `trigger === "update"` branch in `src/auth.ts`.

- [ ] **Step 4: Update `src/app/(auth)/verify-email/page.tsx`**

```typescript
// The inner client component (required for useSearchParams in Next.js 16):
"use client"

import { useSearchParams, useRouter } from "next/navigation"
import { useEffect, useState } from "react"
import { useSession } from "next-auth/react"
import { verifyEmailAction } from "@/actions/auth"

function VerifyEmailInner() {
  const searchParams = useSearchParams()
  const router = useRouter()
  const { update } = useSession()
  const [status, setStatus] = useState<"loading" | "success" | "error">("loading")

  useEffect(() => {
    const token = searchParams.get("token")
    if (!token) { setStatus("error"); return }

    verifyEmailAction(token).then(async (result) => {
      if ("error" in result) {
        setStatus("error")
        return
      }
      // Refresh NextAuth session so emailVerified becomes true in the cookie
      await update()
      setStatus("success")
      setTimeout(() => router.push("/start"), 2000)
    })
  }, [searchParams, router, update])

  if (status === "loading") return <div>Verifying your email…</div>
  if (status === "success") return <div>Email verified! Redirecting…</div>
  return (
    <div>
      This link has expired or is invalid.{" "}
      <a href="/verify-email-pending">Request a new link</a>
    </div>
  )
}

// Outer server component wraps in Suspense (required for useSearchParams):
import { Suspense } from "react"

export default function VerifyEmailPage() {
  return (
    <Suspense fallback={<div>Loading…</div>}>
      <VerifyEmailInner />
    </Suspense>
  )
}
```

