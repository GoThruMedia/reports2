import "next-auth"
import { DefaultSession } from "next-auth"

declare module "next-auth" {
  interface Session {
    accessToken?: string
    user: {
      id: string
      emailVerified: boolean
    } & DefaultSession["user"]
  }

  interface User {
    accessToken?: string
    emailVerified?: boolean
  }
}

declare module "next-auth/jwt" {
  interface JWT {
    accessToken?: string
    emailVerified?: boolean
    userId?: string
  }
}
```

