- [ ] **Step 1: Create `src/components/editor/preview/AreaAutocomplete.tsx`**

  ```tsx
  "use client";

  import { useState, useRef, useEffect } from "react";
  import { Search, X } from "lucide-react";
  import type { AreaLayer, Information } from "@/store/useMapStore";

  export interface AreaAutocompleteProps {
    areas: AreaLayer[];
    informationRecords: Information[];
    showDescription?: boolean;
    placeholder?: string;
    value: AreaLayer | null;
    onChange: (area: AreaLayer | null) => void;
  }

  function resolveInfo(area: AreaLayer, records: Information[]): Information | null {
    if (!area.infoId) return null;
    return records.find((r) => r.id === area.infoId) ?? null;
  }

  function candidatesWithInfo(
    areas: AreaLayer[],
    records: Information[],
    query: string,
    showDescription: boolean
  ): { area: AreaLayer; info: Information }[] {
    const q = query.toLowerCase();
    return areas.flatMap((a) => {
      const info = resolveInfo(a, records);
      if (!info) return [];
      const titleMatch = info.title.toLowerCase().includes(q);
      const descMatch = showDescription && (info.description ?? "").toLowerCase().includes(q);
      return titleMatch || descMatch ? [{ area: a, info }] : [];
    });
  }

  export default function AreaAutocomplete({
    areas,
    informationRecords,
    showDescription = true,
    placeholder = "Search areas…",
    value,
    onChange,
  }: AreaAutocompleteProps) {
    const [query, setQuery] = useState("");
    const [open, setOpen] = useState(false);
    const inputRef = useRef<HTMLInputElement>(null);
    const containerRef = useRef<HTMLDivElement>(null);

    // Close on outside click
    useEffect(() => {
      const h = (e: MouseEvent) => {
        if (containerRef.current && !containerRef.current.contains(e.target as Node))
          setOpen(false);
      };
      document.addEventListener("mousedown", h);
      return () => document.removeEventListener("mousedown", h);
    }, []);

    const matches = value
      ? []
      : candidatesWithInfo(areas, informationRecords, query, showDescription);

    const select = (area: AreaLayer) => {
      onChange(area);
      setQuery("");
      setOpen(false);
    };

    const clear = () => {
      onChange(null);
      setQuery("");
      setOpen(false);
      inputRef.current?.focus();
    };

    const selectedLabel = value
      ? (resolveInfo(value, informationRecords)?.title ?? value.name)
      : null;

    return (
      <div ref={containerRef} className="relative w-full">
        <div
          className="flex items-center gap-2 rounded-[10px] border px-3 h-9"
          style={{
            background: "var(--editor-canvas-white)",
            borderColor: "var(--editor-subtle-ash)",
          }}
        >
          <Search
            className="size-3.5 shrink-0"
            style={{ color: "var(--editor-midtone-gray)" }}
          />

          {selectedLabel ? (
            <>
              <span
                className="flex-1 text-sm truncate"
                style={{ color: "var(--editor-rich-black)" }}
              >
                {selectedLabel}
              </span>
              <button
                onClick={clear}
                className="flex shrink-0 items-center justify-center size-5 rounded hover:bg-(--editor-ghost-gray)"
              >
                <X className="size-3.5" style={{ color: "var(--editor-midtone-gray)" }} />
              </button>
            </>
          ) : (
            <>
              <input
                ref={inputRef}
                className="flex-1 bg-transparent text-sm outline-none min-w-0"
                style={{ color: "var(--editor-rich-black)" }}
                placeholder={placeholder}
                value={query}
                onFocus={() => setOpen(true)}
                onChange={(e) => {
                  setQuery(e.target.value);
                  setOpen(true);
                }}
              />
              {query && (
                <button
                  onClick={clear}
                  className="flex shrink-0 items-center justify-center size-5 rounded hover:bg-(--editor-ghost-gray)"
                >
                  <X className="size-3.5" style={{ color: "var(--editor-midtone-gray)" }} />
                </button>
              )}
            </>
          )}
        </div>

        {open && matches.length > 0 && (
          <div
            className="absolute left-0 right-0 top-full mt-1 z-30 rounded-[10px] border overflow-hidden max-h-52 overflow-y-auto"
            style={{
              background: "var(--editor-canvas-white)",
              borderColor: "var(--editor-subtle-ash)",
              boxShadow: "var(--editor-shadow-popover)",
            }}
          >
            {matches.slice(0, 10).map(({ area, info }) => (
              <button
                key={area.id}
                className="w-full flex flex-col items-start px-3 py-2.5 text-left hover:bg-(--editor-ghost-gray) border-b last:border-b-0"
                style={{ borderColor: "var(--editor-subtle-ash)" }}
                onMouseDown={(e) => {
                  e.preventDefault(); // prevent input blur before select fires
                  select(area);
                }}
              >
                <span
                  className="text-sm font-medium truncate w-full"
                  style={{ color: "var(--editor-rich-black)" }}
                >
                  {info.title}
                </span>
                {showDescription && info.description && (
                  <span
                    className="text-xs mt-0.5 truncate w-full"
                    style={{ color: "var(--editor-midtone-gray)" }}
                  >
                    {info.description}
                  </span>
                )}
              </button>
            ))}
          </div>
        )}
      </div>
    );
  }
  ```

