  type PreviewFeature = "search" | "direction" | null;
  const [activeFeature, setActiveFeature] = useState<PreviewFeature>(null);
  const [dirState, setDirState] = useState<DirectionState>({
    fromMode: "select-area",
    fromArea: null,
    fromPin: null,
    toArea: null,
  });
  const [routeStatus, setRouteStatus] = useState<"idle" | "found" | "none">("idle");

  // Single-level constraint: features require exactly one level to be visible
  const allLevelIds = canvasData?.levels.map((l) => l.level_id) ?? [];
  const effectiveVisibleIds = visibleLevelIds ?? allLevelIds;
  const isSingleLevel = effectiveVisibleIds.length === 1;
  const singleLevelId = isSingleLevel ? effectiveVisibleIds[0] : null;
  const singleLevel = canvasData?.levels.find((l) => l.level_id === singleLevelId) ?? null;

  // Areas on the active level that appear in search/direction results
  const activeAreas = singleLevel?.layout.areas ?? [];
