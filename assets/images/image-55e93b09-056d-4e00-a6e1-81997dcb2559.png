  // Dropped-location pin icon (reuses existing PIN_IMG)
  const DROP_SRC = "preview-dropped-pin-src";
  const DROP_LAYER = "preview-dropped-pin";
  useEffect(() => {
    if (!map || !canvasData) return;
    const rotate = makePixelRotator(canvasData);
    const { cxPx, cyPx, mpp } = computeCoordSpace(canvasData);

    const coords: [number, number] | null =
      activeFeature === "direction" &&
      dirState.fromMode === "dropped-location" &&
      dirState.fromPin
        ? (() => {
            const [rx, ry] = rotate(dirState.fromPin[0], dirState.fromPin[1]);
            return pixelToLngLat(rx, ry, cxPx, cyPx, mpp, lng, lat);
          })()
        : null;

    const data: FC = {
      type: "FeatureCollection",
      features: coords
        ? [{ type: "Feature", geometry: { type: "Point", coordinates: coords }, properties: {} }]
        : [],
    };

    const ensure = () => {
      ensurePinImage(map);
      if (!map.getSource(DROP_SRC)) map.addSource(DROP_SRC, { type: "geojson", data });
      else (map.getSource(DROP_SRC) as maplibregl.GeoJSONSource).setData(data);
      if (!map.getLayer(DROP_LAYER))
