- [ ] **Step 1: Create `src/components/editor/preview/SearchAreaPanel.tsx`**

  ```tsx
  "use client";

  import { useState } from "react";
  import AreaAutocomplete from "./AreaAutocomplete";
  import type { AreaLayer, Information } from "@/store/useMapStore";

  export interface SearchAreaPanelProps {
    areas: AreaLayer[];
    informationRecords: Information[];
    onSelect: (area: AreaLayer) => void;
  }

  export default function SearchAreaPanel({
    areas,
    informationRecords,
    onSelect,
  }: SearchAreaPanelProps) {
    const [value, setValue] = useState<AreaLayer | null>(null);

    const handleChange = (area: AreaLayer | null) => {
      setValue(area);
      if (area) onSelect(area);
    };

    return (
      <div className="w-[280px]">
        <AreaAutocomplete
          areas={areas}
          informationRecords={informationRecords}
          showDescription
          placeholder="Search by name or description…"
          value={value}
          onChange={handleChange}
        />
      </div>
    );
  }
  ```

