- [ ] **Step 3: Add the wall grid and route path computation (useMemo)**

  After the state declarations from Step 2, add:

  ```tsx
  // Rebuild the wall grid whenever the active level changes (cheap: ~1ms for 200×200)
  const wallGrid = useMemo(() => {
    if (!singleLevel) return null;
    const bbox = computeLevelBbox(singleLevel);
    if (!bbox) return null;
    const doors = singleLevel.floorplanMeta?.doors ?? [];
    return buildGrid(singleLevel.layout.walls, doors, bbox);
  }, [singleLevel]);

  // Recompute route whenever From/To endpoints change
  const routePath = useMemo(() => {
    if (!wallGrid || !canvasData) return null;
    const { fromMode, fromArea, fromPin, toArea } = dirState;
    if (!toArea) return null;

    const rotate = makePixelRotator(canvasData);
    const { cxPx, cyPx, mpp } = computeCoordSpace(canvasData);
    const toLngLat = (px: number, py: number): [number, number] => {
      const [rx, ry] = rotate(px, py);
      return pixelToLngLat(rx, ry, cxPx, cyPx, mpp, lng, lat);
    };

    // Resolve To centroid in canvas px
    const toAnchor = findAreaAnchor(canvasData, toArea.id, toArea.id);
    if (!toAnchor) return null;
    const toPx: [number, number] = [toAnchor.cx, toAnchor.cy];

    // Resolve From in canvas px
    let fromPx: [number, number] | null = null;
    if (fromMode === "select-area" && fromArea) {
      const fromAnchor = findAreaAnchor(canvasData, fromArea.id, fromArea.id);
      if (fromAnchor) fromPx = [fromAnchor.cx, fromAnchor.cy];
    } else if (fromMode === "dropped-location" && fromPin) {
      fromPx = fromPin;
    }
    if (!fromPx) return null;

    const pixelPath = findPath(wallGrid, fromPx, toPx);
    if (!pixelPath) return null;

    // Convert canvas-pixel path to lng/lat for MapLibre
    return pixelPath.map(([x, y]) => toLngLat(x, y));
  }, [wallGrid, dirState, canvasData, lng, lat]);

  // Sync routeStatus whenever routePath changes
  useEffect(() => {
    const { fromMode, fromArea, fromPin, toArea } = dirState;
    const hasFrom =
      (fromMode === "select-area" && fromArea !== null) ||
      (fromMode === "dropped-location" && fromPin !== null);
    const hasTo = toArea !== null;
    if (!hasFrom || !hasTo) { setRouteStatus("idle"); return; }
    setRouteStatus(routePath ? "found" : "none");
  }, [routePath, dirState]);
  ```

- [ ] **Step 4: Add area-centroid dot layer (Direction mode only)**

  After the existing dropped-pin `useEffect` (around line 192 in the original), add a new `useEffect`:

  ```tsx
  // Area centroid dots — small blue circles at centres of areas-with-info.
  // Only rendered when Direction mode is active on a single level.
  const AREA_DOTS_SRC = "preview-area-dots-src";
  const AREA_DOTS_LAYER = "preview-area-dots";
  useEffect(() => {
    if (!map || !canvasData) return;
    const rotate = makePixelRotator(canvasData);
    const { cxPx, cyPx, mpp } = computeCoordSpace(canvasData);
    const toLngLat = (px: number, py: number): [number, number] => {
      const [rx, ry] = rotate(px, py);
      return pixelToLngLat(rx, ry, cxPx, cyPx, mpp, lng, lat);
    };

    const showDots = activeFeature === "direction" && isSingleLevel && singleLevel;
    const feats: FC["features"] = showDots
      ? singleLevel!.layout.areas
          .filter((a) => informationRecords.some((r) => r.id === a.infoId))
          .flatMap((a) => {
            const anchor = findAreaAnchor(canvasData, a.id, a.id);
            if (!anchor) return [];
            const [lo, la] = toLngLat(anchor.cx, anchor.cy);
            return [{ type: "Feature" as const, geometry: { type: "Point" as const, coordinates: [lo, la] as [number, number] }, properties: { id: a.id } }];
          })
      : [];

    const data: FC = { type: "FeatureCollection", features: feats };

    const ensure = () => {
      if (!map.getSource(AREA_DOTS_SRC)) map.addSource(AREA_DOTS_SRC, { type: "geojson", data });
      else (map.getSource(AREA_DOTS_SRC) as maplibregl.GeoJSONSource).setData(data);
      if (!map.getLayer(AREA_DOTS_LAYER))
        map.addLayer({
          id: AREA_DOTS_LAYER,
          type: "circle",
          source: AREA_DOTS_SRC,
          paint: {
            "circle-radius": 7,
            "circle-color": "#3b82f6",
            "circle-opacity": 0.85,
            "circle-stroke-width": 2,
            "circle-stroke-color": "#ffffff",
          },
        });
    };
    if (map.isStyleLoaded()) ensure(); else map.once("styledata", ensure);
    map.on("styledata", ensure);
    return () => {
      map.off("styledata", ensure);
      try { if (map.getLayer(AREA_DOTS_LAYER)) map.removeLayer(AREA_DOTS_LAYER); } catch { /* ignore */ }
      try { if (map.getSource(AREA_DOTS_SRC)) map.removeSource(AREA_DOTS_SRC); } catch { /* ignore */ }
    };
  }, [map, canvasData, activeFeature, isSingleLevel, singleLevel, informationRecords, lng, lat]);
  ```

