  export type FromMode = "select-area" | "dropped-location";

  export interface DirectionState {
    fromMode: FromMode;
    fromArea: AreaLayer | null;      // set when fromMode === "select-area"
    fromPin: [number, number] | null; // canvas px, set when fromMode === "dropped-location"
    toArea: AreaLayer | null;
  }

  export interface DirectionPanelProps {
    areas: AreaLayer[];
    informationRecords: Information[];
    state: DirectionState;
    onStateChange: (patch: Partial<DirectionState>) => void;
    routeStatus: "idle" | "found" | "none"; // "none" = no path available
    isAwaitingPin: boolean; // true when dropped-location mode and no pin yet
  }
  export default function DirectionPanel(props: DirectionPanelProps): JSX.Element
  ```

- [ ] **Step 1: Create `src/components/editor/preview/DirectionPanel.tsx`**

  ```tsx
  "use client";

  import { MapPin, Navigation } from "lucide-react";
  import AreaAutocomplete from "./AreaAutocomplete";
  import type { AreaLayer, Information } from "@/store/useMapStore";

  export type FromMode = "select-area" | "dropped-location";

  export interface DirectionState {
    fromMode: FromMode;
    fromArea: AreaLayer | null;
    fromPin: [number, number] | null; // canvas pixel coords
    toArea: AreaLayer | null;
  }

  export interface DirectionPanelProps {
    areas: AreaLayer[];
    informationRecords: Information[];
    state: DirectionState;
    onStateChange: (patch: Partial<DirectionState>) => void;
    routeStatus: "idle" | "found" | "none";
    isAwaitingPin: boolean;
  }

  export default function DirectionPanel({
    areas,
    informationRecords,
    state,
    onStateChange,
    routeStatus,
    isAwaitingPin,
  }: DirectionPanelProps) {
    const { fromMode, fromArea, fromPin, toArea } = state;

    const setFromMode = (mode: FromMode) =>
      onStateChange({ fromMode: mode, fromArea: null, fromPin: null });

    return (
      <div
        className="w-[300px] rounded-[14px] border p-4 flex flex-col gap-3"
        style={{
          background: "var(--editor-canvas-white)",
          borderColor: "var(--editor-subtle-ash)",
          boxShadow: "var(--editor-shadow-popover)",
        }}
      >
        {/* To */}
        <div className="flex flex-col gap-1.5">
          <label className="text-[11px] font-semibold uppercase tracking-wide" style={{ color: "var(--editor-midtone-gray)" }}>
            To
          </label>
          <AreaAutocomplete
            areas={areas}
            informationRecords={informationRecords}
            showDescription
            placeholder="Search destination…"
            value={toArea}
            onChange={(area) => onStateChange({ toArea: area })}
          />
        </div>

        {/* From */}
        <div className="flex flex-col gap-1.5">
          <label className="text-[11px] font-semibold uppercase tracking-wide" style={{ color: "var(--editor-midtone-gray)" }}>
            From
          </label>

          {/* Mode toggle */}
          <div
            className="flex rounded-[8px] border overflow-hidden"
            style={{ borderColor: "var(--editor-subtle-ash)" }}
          >
            {(["select-area", "dropped-location"] as FromMode[]).map((mode) => (
              <button
                key={mode}
                onClick={() => setFromMode(mode)}
                className="flex-1 flex items-center justify-center gap-1.5 py-1.5 text-xs font-medium transition-colors"
                style={{
                  background: fromMode === mode ? "var(--editor-rich-black)" : "transparent",
                  color: fromMode === mode ? "var(--editor-canvas-white)" : "var(--editor-midtone-gray)",
                }}
              >
                {mode === "select-area" ? (
                  <><Navigation className="size-3" /> Select Area</>
                ) : (
                  <><MapPin className="size-3" /> Drop Pin</>
                )}
              </button>
            ))}
          </div>

          {/* From input — varies by mode */}
          {fromMode === "select-area" ? (
            <AreaAutocomplete
              areas={areas}
              informationRecords={informationRecords}
              showDescription={false}
              placeholder="Search origin…"
              value={fromArea}
              onChange={(area) => onStateChange({ fromArea: area })}
            />
          ) : (
            <div
              className="flex items-center gap-2 rounded-[10px] border px-3 h-9"
              style={{
                background: "var(--editor-canvas-white)",
                borderColor: "var(--editor-subtle-ash)",
                color: "var(--editor-midtone-gray)",
              }}
            >
              <MapPin className="size-3.5 shrink-0" />
              <span className="text-sm">
                {fromPin
                  ? "Pin dropped — tap map to move"
                  : isAwaitingPin
                  ? "Tap the map to drop a pin…"
                  : "Tap the map to set origin"}
              </span>
            </div>
          )}
        </div>

        {/* Route status */}
        {routeStatus === "none" && (
          <div
            className="flex items-center gap-2 rounded-[10px] px-3 py-2 text-sm"
            style={{ background: "#fef2f2", color: "#991b1b" }}
          >
            No route available
          </div>
        )}
        {routeStatus === "found" && (
          <div
            className="flex items-center gap-2 rounded-[10px] px-3 py-2 text-sm"
            style={{ background: "#eff6ff", color: "#1d4ed8" }}
          >
            Route found
          </div>
        )}
      </div>
    );
  }
  ```

