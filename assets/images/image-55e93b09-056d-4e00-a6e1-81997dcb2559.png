- [ ] **Step 7: Add map-click handler for dropped pin**

  After the existing marker click `useEffect` (around line 173), add:

  ```tsx
  // Dropped-location pin: any map click in direction+dropped mode sets the From pin
  useEffect(() => {
    if (!map) return;
    const onClick = (e: maplibregl.MapMouseEvent) => {
      if (activeFeature !== "direction") return;
      if (dirState.fromMode !== "dropped-location") return;
      if (!canvasData) return;

      // Convert map click lngLat back to canvas pixel coords (inverse of pixelToLngLat)
      const { cxPx, cyPx, mpp } = computeCoordSpace(canvasData);
      const rotate = makePixelRotator(canvasData);

      // We need the inverse rotation. For simplicity, use the approximation:
      // canvas pixel ≈ (lngLat - origin) / mpp, then un-rotate.
      // Since makePixelRotator gives us the forward transform, use small angle inversion.
      const { lat: clat, lng: clng } = e.lngLat;
      const METERS_PER_DEG_LAT = 111320;
      const METERS_PER_DEG_LNG = 111320 * Math.cos((lat * Math.PI) / 180);
      const dx = (clng - lng) * METERS_PER_DEG_LNG / mpp;
      const dy = (clat - lat) * METERS_PER_DEG_LAT / mpp;
      // Undo rotation: rotate by negative angle
      const rot = -(canvasData.mapRotationDeg ?? 0);
      const scale = canvasData.mapScale ?? 1;
      const rad = (rot * Math.PI) / 180;
      const cos = Math.cos(rad), sin = Math.sin(rad);
      const rx = dx * cos - dy * sin;
      const ry = dx * sin + dy * cos;
      const px = cxPx + rx / scale - (canvasData.mapOffsetX ?? 0) / scale;
      const py = cyPx + ry / scale - (canvasData.mapOffsetY ?? 0) / scale;
      setDirState((s) => ({ ...s, fromPin: [px, py] }));
    };
    map.on("click", onClick);
    return () => map.off("click", onClick);
  }, [map, activeFeature, dirState.fromMode, canvasData, lng, lat]);
  ```

  > **Implementation note:** The inverse-projection in this step is an approximation that works well for small floor-plan extents (< 500 m). For precise inversion, expose `lngLatToPixel` from `geojson-utils.ts` — but the approximation is adequate for this use case.

