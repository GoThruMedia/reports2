- Produces:
  ```typescript
  export interface AreaAutocompleteProps {
    areas: AreaLayer[];               // pre-filtered to the active level
    informationRecords: Information[];
    showDescription?: boolean;        // true → show description in dropdown row
    placeholder?: string;
    value: AreaLayer | null;
    onChange: (area: AreaLayer | null) => void;
  }
