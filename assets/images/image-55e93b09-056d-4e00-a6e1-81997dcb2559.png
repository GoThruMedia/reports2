          source: DROP_SRC,
          layout: { "icon-image": PIN_IMG, "icon-size": 1.0, "icon-anchor": "bottom", "icon-allow-overlap": true },
        });
    };
    if (map.isStyleLoaded()) ensure(); else map.once("styledata", ensure);
    map.on("styledata", ensure);
    return () => {
      map.off("styledata", ensure);
      try { if (map.getLayer(DROP_LAYER)) map.removeLayer(DROP_LAYER); } catch { /* ignore */ }
      try { if (map.getSource(DROP_SRC)) map.removeSource(DROP_SRC); } catch { /* ignore */ }
    };
  }, [map, canvasData, activeFeature, dirState.fromMode, dirState.fromPin, lng, lat]);
