## Task 1: Wall-Aware Pathfinder

**Files:**
- Create: `src/lib/routing/pathfinder.ts`

**Interfaces:**
- Produces:
  - `export interface WallGrid { cols: number; rows: number; minX: number; minY: number; blocked: Uint8Array; }`
  - `export function computeLevelBbox(level: LevelData): { minX: number; minY: number; maxX: number; maxY: number } | null`
  - `export function buildGrid(walls: WallLayer[], doors: FloorplanSegment[], bbox: BBox): WallGrid`
  - `export function findPath(grid: WallGrid, from: [number, number], to: [number, number]): [number, number][] | null`

- [ ] **Step 1: Create `src/lib/routing/pathfinder.ts` with types, bbox helper, and grid builder**

  ```typescript
  import type { WallLayer, LevelData } from "@/store/useMapStore";
  import type { FloorplanSegment } from "@/store/useMapStore";

  // Tuning constants — values copied verbatim from the spec's "Constants Reference".
  // CELL_PX is fine enough to thread a 40px doorway (8 cells wide) while keeping
  // the grid small (~200×200 for a 1000px floorplan).
  const CELL_PX = 5;          // canvas pixels per grid cell
  const DEFAULT_WALL_W = 15;  // fallback wall width (px) when WallLayer.width is undefined
  const DOOR_MARGIN = 15;     // px clearance carved around each door segment
  const SNAP_RADIUS = 25;     // max cells BFS expands to find nearest passable endpoint

  export interface WallGrid {
    cols: number;
    rows: number;
    minX: number;
    minY: number;
    blocked: Uint8Array; // 1 = wall/blocked, 0 = passable
  }

  type BBox = { minX: number; minY: number; maxX: number; maxY: number };

  export function computeLevelBbox(level: LevelData): BBox | null {
    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    for (const wall of level.layout.walls) {
      for (const [x, y] of wall.points) {
        if (x < minX) minX = x; if (x > maxX) maxX = x;
        if (y < minY) minY = y; if (y > maxY) maxY = y;
      }
    }
    for (const area of level.layout.areas) {
      for (const [x, y] of area.boundaries) {
        if (x < minX) minX = x; if (x > maxX) maxX = x;
        if (y < minY) minY = y; if (y > maxY) maxY = y;
      }
    }
    if (minX === Infinity) return null;
    return { minX, maxX, minY, maxY };
  }

  function distToSegmentSq(
    px: number, py: number,
    ax: number, ay: number,
    bx: number, by: number
  ): number {
    const dx = bx - ax, dy = by - ay;
    const lenSq = dx * dx + dy * dy;
    if (lenSq === 0) return (px - ax) ** 2 + (py - ay) ** 2;
    const t = Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / lenSq));
    return (px - ax - t * dx) ** 2 + (py - ay - t * dy) ** 2;
  }

  export function buildGrid(
    walls: WallLayer[],
    doors: FloorplanSegment[],
    bbox: BBox
  ): WallGrid {
    const cols = Math.ceil((bbox.maxX - bbox.minX) / CELL_PX) + 2;
    const rows = Math.ceil((bbox.maxY - bbox.minY) / CELL_PX) + 2;
    const blocked = new Uint8Array(cols * rows);

    // Rasterize each wall segment as a thick line
    for (const wall of walls) {
      const halfW = (wall.width ?? DEFAULT_WALL_W) / 2 + CELL_PX; // expand by 1 cell for safety
      const halfWSq = halfW * halfW;
      for (let i = 0; i < wall.points.length - 1; i++) {
        const [ax, ay] = wall.points[i];
        const [bx, by] = wall.points[i + 1];
        const c0 = Math.max(0, Math.floor((Math.min(ax, bx) - halfW - bbox.minX) / CELL_PX));
        const c1 = Math.min(cols - 1, Math.ceil((Math.max(ax, bx) + halfW - bbox.minX) / CELL_PX));
        const r0 = Math.max(0, Math.floor((Math.min(ay, by) - halfW - bbox.minY) / CELL_PX));
        const r1 = Math.min(rows - 1, Math.ceil((Math.max(ay, by) + halfW - bbox.minY) / CELL_PX));
        for (let r = r0; r <= r1; r++) {
          for (let c = c0; c <= c1; c++) {
            const wx = bbox.minX + c * CELL_PX;
            const wy = bbox.minY + r * CELL_PX;
            if (distToSegmentSq(wx, wy, ax, ay, bx, by) <= halfWSq) {
              blocked[r * cols + c] = 1;
            }
          }
        }
      }
    }

    // Carve door openings — FloorplanSegment x1,y1,x2,y2 are canvas pixel coords
    for (const door of doors) {
      const margin = DOOR_MARGIN; // clearance so the router can thread the gap
      const c0 = Math.max(0, Math.floor((Math.min(door.x1, door.x2) - margin - bbox.minX) / CELL_PX));
      const c1 = Math.min(cols - 1, Math.ceil((Math.max(door.x1, door.x2) + margin - bbox.minX) / CELL_PX));
      const r0 = Math.max(0, Math.floor((Math.min(door.y1, door.y2) - margin - bbox.minY) / CELL_PX));
      const r1 = Math.min(rows - 1, Math.ceil((Math.max(door.y1, door.y2) + margin - bbox.minY) / CELL_PX));
      for (let r = r0; r <= r1; r++) {
        for (let c = c0; c <= c1; c++) {
          blocked[r * cols + c] = 0;
        }
      }
    }

    return { cols, rows, minX: bbox.minX, minY: bbox.minY, blocked };
  }
  ```

