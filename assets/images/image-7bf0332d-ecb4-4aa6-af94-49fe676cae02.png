  useFloorPlanLabels({
    map, canvasData, location: { lat, lng }, floorConfigs, visibleLevelIds: visibleLevelIds ?? null, visible: true,
    hideAreaIds: selection?.kind === "area" ? [selection.id.replace(/(_d)+$/, "")] : [],
