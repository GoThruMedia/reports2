## Task 3: Add `viewMode`, Hover-Only Labels, and Zoom-Adaptive Labels to `useFloorPlanLabels`

**Files:**
- Modify: `src/lib/map/useFloorPlanLabels.ts`

**Interfaces:**
- Consumes: nothing new from prior tasks (standalone hook change)
- Produces: `Options.viewMode?: ViewMode`, `Options.hoveredAreaId?: string | null`, `Options.buildingName?: string` — consumed by Tasks 4 & 5

- [ ] **Step 1: Add the `LABEL_DETAIL_ZOOM` constant**

  At the top of `src/lib/map/useFloorPlanLabels.ts`, after the existing constants (`LEVEL_GAP`, `LABEL_LAYER`), add:
  ```ts
  const LABEL_DETAIL_ZOOM = 17.5;
  ```

- [ ] **Step 2: Add new props to the `Options` interface**

  The current `Options` interface ends at line 24. Extend it:
  ```ts
  interface Options {
    map: maplibregl.Map | null;
    canvasData: CanvasData | null;
    location: { lat: number; lng: number } | null;
    floorConfigs: FloorConfig[];
    /** null = all levels (3D default), string[] = only these level IDs */
    visibleLevelIds: string[] | null;
    visible: boolean;
    /** Area ids whose canvas label should be suppressed (e.g. the selected room showing a pin). */
    hideAreaIds?: string[];
    /** A large label drawn on top of everything (the selected room's pin label). */
    pinLabel?: { lng: number; lat: number; h: number; text: string } | null;
    /** Controls label draw behaviour. Defaults to "preview" when omitted (all labels visible). */
    viewMode?: "editor" | "preview" | "map";
    /** Editor mode: the id of the currently hovered area — only its label is drawn. */
    hoveredAreaId?: string | null;
    /** Map/preview mode: shown at the building centre when zoom < LABEL_DETAIL_ZOOM. */
    buildingName?: string;
  }
  ```

- [ ] **Step 3: Add refs for the new props at the top of `useFloorPlanLabels`**

  The hook signature currently reads:
  ```ts
  export function useFloorPlanLabels({
    map, canvasData, location, floorConfigs, visibleLevelIds, visible, hideAreaIds, pinLabel,
  }: Options) {
  ```
  Change it to:
  ```ts
  export function useFloorPlanLabels({
    map, canvasData, location, floorConfigs, visibleLevelIds, visible,
    hideAreaIds, pinLabel, viewMode, hoveredAreaId, buildingName,
  }: Options) {
  ```

  Then, directly after the existing `pinRef` declaration and its sync effect (after line 61), add:
  ```ts
  const viewModeRef  = useRef(viewMode);
  const hoveredIdRef = useRef(hoveredAreaId ?? null);
  const buildingRef  = useRef(buildingName ?? "");
  const zoomRef      = useRef(0);

  useEffect(() => { viewModeRef.current  = viewMode ?? "preview"; }, [viewMode]);
  useEffect(() => {
    hoveredIdRef.current = hoveredAreaId ?? null;
    map?.triggerRepaint();
  }, [map, hoveredAreaId]);
  useEffect(() => { buildingRef.current  = buildingName ?? ""; }, [buildingName]);
  ```

- [ ] **Step 4: Add zoom tracking inside the main `useEffect`**

  The main `useEffect` currently ends at line 201 with:
  ```ts
  }, [map, visible, canvasData, location, floorConfigs, visibleLevelIds]);
  ```

  Inside the effect, after `map.on("resize", onResize);` (line 193) and before `return () => {`, add the zoom listener:
  ```ts
  zoomRef.current = map.getZoom();
  const onZoom = () => {
    zoomRef.current = map.getZoom();
    map.triggerRepaint();
  };
  map.on("zoom", onZoom);
  ```

  And in the cleanup `return () => {` block, before `canvas.remove();`, add:
  ```ts
  map.off("zoom", onZoom);
  ```

  Also add `viewMode` to the dependency array so the canvas is recreated when the mode switches:
  ```ts
  }, [map, visible, canvasData, location, floorConfigs, visibleLevelIds, viewMode]);
  ```

- [ ] **Step 5: Replace the per-anchor drawing loop in `draw` with mode-aware branching**

  The `draw` function currently has this structure (lines 122–175):
  ```ts
  function draw(m: ArrayLike<number>) {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    ctx.lineJoin = "round";
    const placed: { x0: number; y0: number; x1: number; y1: number }[] = [];

    // pin reservation block (lines 129–139)
    const pin = pinRef.current;
    let pinDraw: { x: number; y: number; text: string; tw: number } | null = null;
    if (pin) { ... }

    ctx.font = "600 11px system-ui,-apple-system,sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    for (let i = 0; i < anchors.length; i++) {
      // ... existing declutter + draw loop (lines 144–162)
    }

    // pin label draw (lines 164–174)
    if (pinDraw) { ... }
  }
  ```

  Replace **only the section between the pin reservation block and the pin label draw** — i.e., replace lines 141–162 (the `ctx.font` setup + the for-loop) with:

  ```ts
  ctx.font = "600 11px system-ui,-apple-system,sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";

  const vm   = viewModeRef.current ?? "preview";
  const zoom = zoomRef.current;

  if (vm === "editor") {
    // Editor mode: show only the hovered area's label (if it has a name)
    const hovId = hoveredIdRef.current;
    if (hovId) {
      const idx = anchors.findIndex((a) => a.id === hovId);
      if (idx >= 0 && anchors[idx].name && !hideRef.current.has(hovId)) {
        const sp = projScreen(m, merc[idx]);
        if (sp) {
          const name = anchors[idx].name;
          ctx.lineWidth = 3; ctx.strokeStyle = "rgba(15,23,42,0.85)";
          ctx.strokeText(name, sp[0], sp[1]);
          ctx.fillStyle = "#ffffff";
          ctx.fillText(name, sp[0], sp[1]);
        }
      }
    }
  } else if (zoom < LABEL_DETAIL_ZOOM) {
    // Map/preview zoomed out: show building name at location centre (height 0)
    const bName = buildingRef.current;
    if (bName) {
      const locMerc = MercatorCoordinate.fromLngLat([loc.lng, loc.lat], 0);
      const sp = projScreen(m, locMerc);
      if (sp) {
        ctx.font = "700 14px system-ui,-apple-system,sans-serif";
        ctx.lineWidth = 3; ctx.strokeStyle = "rgba(15,23,42,0.85)";
        ctx.strokeText(bName, sp[0], sp[1]);
        ctx.fillStyle = "#ffffff";
        ctx.fillText(bName, sp[0], sp[1]);
        // restore font for any subsequent draw (pin label uses its own font)
        ctx.font = "600 11px system-ui,-apple-system,sans-serif";
      }
    }
  } else {
    // Map/preview zoomed in (or default): all area labels with declutter
    for (let i = 0; i < anchors.length; i++) {
      if (hideRef.current.has(anchors[i].id)) continue;
      const p = merc[i];
      const [cx, cy, , cw] = project(m, p.x, p.y, p.z);
      if (cw <= 0) continue;
      const sx = (cx / cw * 0.5 + 0.5) * W;
      const sy = (1 - (cy / cw * 0.5 + 0.5)) * H;
      if (sx < -50 || sy < -20 || sx > W + 50 || sy > H + 20) continue;
      const name = anchors[i].name;
      const tw = ctx.measureText(name).width;
      const box = { x0: sx - tw / 2 - 3, y0: sy - 9, x1: sx + tw / 2 + 3, y1: sy + 9 };
      if (placed.some((b) => box.x0 < b.x1 && box.x1 > b.x0 && box.y0 < b.y1 && box.y1 > b.y0)) continue;
      placed.push(box);
      ctx.lineWidth = 3; ctx.strokeStyle = "rgba(15,23,42,0.85)";
      ctx.strokeText(name, sx, sy);
      ctx.fillStyle = "#ffffff";
      ctx.fillText(name, sx, sy);
    }
  }
  ```

  The pin label block (the `if (pinDraw)` section at lines 164–174) is **unchanged** — leave it exactly as-is so the selected-room pin label still renders in all modes.

