    selectedFeatureIds?: string[];
    /** null = all levels (3D default), undefined/null in flat = only active level */
    visibleLevelIds?: string[] | null;
    /** Controls hover highlight behaviour and fill colour. Defaults to "preview" when omitted. */
    viewMode?: ViewMode;
  }
  ```

- [ ] **Step 4: Add a `viewModeRef` to the hook body**

  In `useFloorPlanLayer` (starting at line 119), add `viewMode` to the destructured parameters and add a ref for it alongside the existing refs:

  Change the destructuring line:
  ```ts
  export function useFloorPlanLayer({
    map, canvasData, floorConfigs, location, activeLevelId, visible, mode,
    hoveredFeatureId, selectedFeatureIds, visibleLevelIds,
  }: FloorPlanLayerOptions) {
  ```
  to:
  ```ts
