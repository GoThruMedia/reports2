    map, canvasData, floorConfigs, location, activeLevelId, visible, mode,
    hoveredFeatureId, selectedFeatureIds, visibleLevelIds, viewMode,
  }: FloorPlanLayerOptions) {
  ```

  Then add a ref for `viewMode` directly after the block of existing `useRef` declarations (after `visibleLevelIdsRef`):
  ```ts
  const viewModeRef = useRef(viewMode);
  ```

  And add its sync effect alongside the other sync effects:
  ```ts
  useEffect(() => { viewModeRef.current = viewMode; }, [viewMode]);
  ```

- [ ] **Step 5: Add `applyHighlightPaint` helper function**

  Insert this new function immediately before the `useFloorPlanLayer` export (i.e., before line 119 in the original file, after the existing `applyHighlight` function):

  ```ts
  function applyHighlightPaint(map: maplibregl.Map, vm: ViewMode | undefined) {
    if (!map.getLayer(LAYER_IDS.highlightArea3d)) return;
    const subtle = vm === "preview" || vm === "map";
    map.setPaintProperty(
      LAYER_IDS.highlightArea3d,
      "fill-extrusion-color",
      subtle ? HOVER_FILL_COLOR_SUBTLE : "#3b82f6",
    );
    map.setPaintProperty(
      LAYER_IDS.highlightArea3d,
      "fill-extrusion-opacity",
      subtle ? HOVER_FILL_OPACITY_SUBTLE : 0.55,
    );
  }
  ```

- [ ] **Step 6: Suppress highlight in editor mode and call `applyHighlightPaint` in the hover effect**

  Find the "Apply highlight on hover change" effect (lines 173–176):
  ```ts
  // Apply highlight on hover change
  useEffect(() => {
    if (!map) return;
    applyHighlight(map, hoveredFeatureId);
  }, [map, hoveredFeatureId]);
  ```

  Replace it with:
  ```ts
  // Apply highlight on hover change — suppressed entirely in editor mode
  useEffect(() => {
    if (!map) return;
    const suppress = viewModeRef.current === "editor";
    applyHighlight(map, suppress ? null : hoveredFeatureId);
  }, [map, hoveredFeatureId, viewMode]);

  // Override highlight layer paint when viewMode changes
  useEffect(() => {
    if (!map) return;
    applyHighlightPaint(map, viewMode);
  }, [map, viewMode]);
  ```

- [ ] **Step 7: Call `applyHighlightPaint` after `addSourceAndLayers` in the mode-switch effect**

  Find the mode-switch effect (the `useEffect` with `[map, mode]` dependency). It ends with `applySelection(map, selectedIdsRef.current);`. Add the paint call right after:

