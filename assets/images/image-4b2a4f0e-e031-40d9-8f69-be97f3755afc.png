            "discovery",
            "metadata",
            "search"
          ]
        }
      ]
    },
    {
      "id": "troubleshooting",
      "title": "Troubleshooting",
      "description": "Resolve common publishing, media, account, and visibility issues.",
      "icon": "settings",
      "faqs": [
        {
          "id": "post-not-visible",
          "question": "Why is my post not visible?",
          "answer": "The post may be unpublished, pending review, inactive, hidden, deleted, or missing required media. Check that it is active, published, complete, and allowed under the applicable content rules.",
          "keywords": [
            "post not visible",
            "hidden post",
            "publish status"
          ]
        },
        {
          "id": "post-pending",
          "question": "What does pending mean?",
          "answer": "Pending means the post is waiting for processing, review, media conversion, moderation, or another required step before it becomes fully available.",
          "keywords": [
            "pending",
            "processing",
            "review"
          ]
        },
        {
          "id": "post-inactive",
          "question": "What does inactive mean?",
          "answer": "Inactive means a post or account is not currently available for normal public activity or discovery. Review its settings or contact support if you did not expect this status.",
          "keywords": [
            "inactive",
            "status"
          ]
        },
        {
          "id": "missing-location",
          "question": "Why is my post location missing?",
          "answer": "No location may have been selected, the location data may not have saved correctly, or the post may have been created without structured place information. Edit the post and add the location again.",
          "keywords": [
            "missing location",
            "location error"
          ]
        },
        {
          "id": "missing-images-previews",
          "question": "Why does my post have missing images or previews?",
          "answer": "The thumbnail, preview, or panorama file may not have uploaded correctly, may still be processing, may use an unsupported format, or may be incomplete after an import.",
          "keywords": [
            "missing image",
            "preview",
            "upload error"
          ]
        },
        {
          "id": "upload-failed",
          "question": "Why did my upload fail?",
          "answer": "Uploads can fail because of an unstable connection, unsupported file type, file size limit, expired session, or browser issue. Retry on a stable connection and confirm that the file meets the supported requirements.",
          "keywords": [
            "upload failed",
            "file type",
            "file size"
          ]
        },
        {
          "id": "360-content-not-loading",
          "question": "Why is my panorama or 360 video not loading?",
          "answer": "The media may still be processing, the browser may not support the required playback features, the file may be damaged, or the connection may be too slow. Refresh the page, try another supported browser, and verify the source file.",
          "keywords": [
            "not loading",
            "360 video",
            "panorama"
          ]
        },
        {
          "id": "changes-not-saved",
          "question": "Why were my changes not saved?",
          "answer": "Your session may have expired, a required field may be missing, or a network error may have interrupted the request. Reload the page, sign in again if needed, and retry the update.",
          "keywords": [
            "save error",
            "session expired"
          ]
        },
        {
          "id": "cannot-comment-follow-like",
          "question": "Why can’t I comment, follow, like, or bookmark?",
          "answer": "The feature may require sign-in, email verification, an active account, or permission to interact with the selected content. The content owner may also have limited interactions.",
          "keywords": [
            "cannot comment",
            "cannot follow",
            "permissions"
          ]
        },
        {
          "id": "contact-support",
          "question": "How do I contact support?",
          "answer": "Use the Help Center contact form or available support channel. Include your account email, username, affected post link, device or browser details, screenshots, and a concise description of the issue.",
          "keywords": [
            "support",
            "contact",
            "help"
          ]
        }
      ]
    }
  ]
