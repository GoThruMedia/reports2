      "faqs": [
        {
          "id": "categories-work",
          "question": "How do categories work?",
          "answer": "Categories organize posts by topic, such as Leisure, Real Estate, or Business. Choosing the correct category improves browsing, search, recommendations, and analytics.",
          "keywords": [
            "categories",
            "discovery"
          ]
        },
        {
          "id": "location-data-work",
          "question": "How does location data work?",
          "answer": "Posts can include structured location data such as place name, address, latitude, and longitude. This information supports map views, nearby results, and place-based discovery.",
          "keywords": [
            "location data",
            "map",
            "latitude"
          ]
        },
        {
          "id": "find-posts-near-me",
          "question": "How can I find posts near me?",
          "answer": "Use location-based discovery, search, or map features where available. Posts with accurate latitude and longitude are more likely to appear in nearby results.",
          "keywords": [
            "near me",
            "nearby",
            "map"
          ]
        },
        {
          "id": "comments-work",
          "question": "How do comments work?",
          "answer": "Users can comment on posts and may be able to reply to other comments. Comments help creators receive feedback and support discussion around content.",
          "keywords": [
            "comments",
            "replies"
          ]
        },
        {
          "id": "edit-comment",
          "question": "Can I edit a comment?",
          "answer": "If comment editing is supported, open the comment menu and select Edit. Updated comments may be marked as edited.",
          "keywords": [
            "edit comment"
          ]
        },
        {
          "id": "bookmarks",
          "question": "What are bookmarks?",
          "answer": "Bookmarks let you save posts for later. Depending on available features, you may also organize saved posts into folders or collections.",
          "keywords": [
            "bookmarks",
            "saved posts",
            "folders"
          ]
        },
        {
