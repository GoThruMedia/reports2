{
  "version": "1.0.0",
  "product": "Panorra",
  "topics": [
    {
      "id": "getting-started",
      "title": "Getting Started",
      "description": "Learn the basics of Panorra and how to begin exploring immersive content.",
      "icon": "rocket",
      "faqs": [
        {
          "id": "what-is-panorra",
          "question": "What is Panorra?",
          "answer": "Panorra is a platform for creating, sharing, and discovering immersive panorama and 360 content. You can publish posts, explore places, follow creators, comment, bookmark content, and browse visual experiences by category or location.",
          "keywords": [
            "Panorra",
            "platform",
            "360 content",
            "panorama"
          ]
        },
        {
          "id": "how-do-i-create-an-account",
          "question": "How do I create a Panorra account?",
          "answer": "Open the registration page, enter the required account details, accept the applicable terms, and submit the form. You may need to verify your email before all account features become available.",
          "keywords": [
            "register",
            "sign up",
            "account"
          ]
        },
        {
          "id": "why-verify-email",
          "question": "Why should I verify my email?",
          "answer": "Email verification helps protect your account, confirms that you control the email address, and may unlock publishing, recovery, notification, or community features.",
          "keywords": [
            "email verification",
            "account security"
          ]
        },
        {
          "id": "how-do-i-sign-in",
          "question": "How do I sign in?",
          "answer": "Use the email address or username linked to your account and enter your password on the sign-in page. If you cannot sign in, use the password recovery option or contact support.",
          "keywords": [
            "login",
            "sign in",
            "password"
          ]
        },
        {
          "id": "what-can-i-do-on-panorra",
          "question": "What can I do on Panorra?",
          "answer": "You can publish immersive posts, explore panorama and 360 content, follow creators, like and comment on posts, save bookmarks, organize saved content, and discover places by category or location.",
          "keywords": [
            "features",
            "explore",
            "publish"
          ]
        },
        {
          "id": "supported-devices",
          "question": "Which devices can I use with Panorra?",
          "answer": "Panorra is designed for modern web and mobile experiences. Feature availability and immersive playback quality may vary by device, browser, operating system, and hardware capability.",
          "keywords": [
            "device",
            "browser",
            "mobile"
          ]
        },
        {
          "id": "how-do-i-find-help",
          "question": "How do I find help in the Help Center?",
          "answer": "Use the Help Center search field or select a topic card. The FAQ list will filter automatically based on the selected topic.",
          "keywords": [
            "help center",
            "search",
            "topic"
          ]
        }
      ]
    },
    {
      "id": "uploading-content",
      "title": "Uploading Content",
      "description": "Create, publish, edit, and manage panorama and 360 posts.",
      "icon": "cloud-upload",
      "faqs": [
        {
          "id": "types-of-posts",
          "question": "What types of posts can I create?",
          "answer": "You can create panorama posts, 360 video posts, and other supported immersive formats. A post may include a description, category, location, thumbnail, preview image, and immersive media file.",
          "keywords": [
            "post type",
            "panorama",
            "360 video"
          ]
        },
        {
          "id": "publish-a-post",
          "question": "How do I publish a post?",
          "answer": "Create a post, upload the required media, add its details, review the information, and select Publish. The post may appear as published, unpublished, pending, or inactive depending on its status and review state.",
          "keywords": [
            "publish",
            "upload",
            "post"
          ]
        },
        {
          "id": "what-is-panorama-post",
          "question": "What is a panorama post?",
          "answer": "A panorama post contains immersive panoramic media that viewers can explore interactively. It may include a thumbnail, preview image, full panorama file, and a web-optimized version.",
          "keywords": [
            "panorama post",
            "immersive image"
          ]
        },
        {
          "id": "what-is-360-video-post",
          "question": "What is a 360 video post?",
          "answer": "A 360 video post contains immersive video that allows viewers to look around the scene while it plays. Playback controls may vary by device and supported format.",
          "keywords": [
            "360 video",
            "immersive video"
          ]
        },
        {
          "id": "required-post-fields",
          "question": "What information should I add to a post?",
          "answer": "Add a clear title or description, the correct category, an accurate location when relevant, a thumbnail, a preview, and complete panorama or 360 media. Complete metadata improves discovery and presentation.",
          "keywords": [
            "metadata",
            "description",
            "thumbnail"
          ]
        },
        {
          "id": "change-post-category",
          "question": "Can I change a post category later?",
          "answer": "Yes, if editing is available for that post. Select a category that accurately reflects the content because categories affect browsing, recommendations, and analytics.",
          "keywords": [
            "edit category",
            "post category"
          ]
        },
        {
          "id": "create-post-without-location",
          "question": "Can I create a post without a location?",
          "answer": "Yes. However, adding a structured location is recommended because it improves search, nearby discovery, and map-based browsing.",
          "keywords": [
            "location",
            "post"
          ]
        },
        {
          "id": "little-planet",
          "question": "What does “little planet” mean?",
          "answer": "Little planet is a visual effect that transforms a panorama into a spherical, planet-like composition. Availability may depend on the post format and editing tools.",
          "keywords": [
            "little planet",
            "effect",
            "panorama"
          ]
        },
        {
          "id": "animation-filters",
          "question": "What are animation filters?",
          "answer": "Animation filters are motion or visual settings applied to immersive content. They can change how a panorama moves, transitions, or appears during playback.",
          "keywords": [
            "animation",
            "filters",
            "effects"
          ]
        },
        {
          "id": "edit-delete-hide-post",
          "question": "Can I edit, hide, unpublish, or delete a post?",
          "answer": "Available controls may let you edit, hide, unpublish, deactivate, or delete a post. Hidden, unpublished, or inactive posts normally do not appear in public discovery.",
          "keywords": [
            "edit post",
            "delete post",
            "hide post"
          ]
        },
        {
          "id": "improve-post-performance",
          "question": "How can I improve my post performance?",
          "answer": "Use a clear description, select the correct category, add accurate location data, upload high-quality immersive media, use a strong thumbnail, and respond to relevant comments.",
          "keywords": [
            "performance",
            "engagement",
            "discovery"
          ]
        }
      ]
    },
    {
      "id": "account-profile",
      "title": "Account & Profile",
      "description": "Manage your identity, preferences, profile details, and account status.",
      "icon": "user",
      "faqs": [
        {
          "id": "update-profile",
          "question": "How do I update my profile?",
          "answer": "Open your account settings and edit available fields such as username, full name, avatar, country, birthday, gender, and about-me information. Save your changes before leaving the page.",
          "keywords": [
            "profile",
            "edit profile",
            "settings"
          ]
        },
        {
          "id": "username-vs-full-name",
          "question": "What is the difference between username and full name?",
          "answer": "Your username is your unique public handle. Your full name is the display name shown in profile or creator information. Different pages may show one or both.",
          "keywords": [
            "username",
            "full name",
            "display name"
          ]
        },
        {
          "id": "profile-information-use",
          "question": "Why is my profile information used?",
          "answer": "Profile information can identify you as a creator, personalize your experience, support discovery, and improve account or audience insights. Only provide information you are comfortable sharing.",
          "keywords": [
            "profile data",
            "personalization"
          ]
        },
        {
          "id": "language-theme-settings",
          "question": "Can I change my language or theme settings?",
          "answer": "Yes, where supported. Preferences may include language, theme, color style, listing style, thumbnail size, and timezone.",
          "keywords": [
            "language",
            "theme",
            "timezone"
          ]
        },
        {
          "id": "change-password",
          "question": "How do I change my password?",
          "answer": "Open the security section of your account settings, enter your current password, then create and confirm a new password. Use a strong password that you do not reuse elsewhere.",
          "keywords": [
            "password",
            "security"
          ]
        },
        {
          "id": "forgot-password",
          "question": "What should I do if I forgot my password?",
          "answer": "Select the password recovery option on the sign-in page and follow the instructions sent to your registered email address. Check your spam folder if the message does not arrive.",
          "keywords": [
            "forgot password",
            "reset password"
          ]
        },
        {
          "id": "inactive-account",
          "question": "Why is my account inactive?",
          "answer": "An account may become inactive because of account settings, incomplete setup, moderation, security review, or administrative action. Check for account notices or contact support for clarification.",
          "keywords": [
            "inactive account",
            "account status"
          ]
        },
        {
          "id": "delete-account",
          "question": "How do I delete my account?",
          "answer": "Open your account or privacy settings and use the account deletion option if available. Review the consequences carefully because deletion may remove access to posts, comments, bookmarks, and profile data.",
          "keywords": [
            "delete account",
            "close account"
          ]
        }
      ]
    },
    {
      "id": "privacy-safety",
      "title": "Privacy & Safety",
      "description": "Understand privacy controls, account protection, reporting, and youth safety.",
      "icon": "shield",
      "faqs": [
        {
          "id": "location-use",
          "question": "How does Panorra use my location?",
          "answer": "Location can help organize posts, improve search, show nearby content, and support map-based discovery. Profile location and post location are separate and may be managed independently.",
          "keywords": [
            "location privacy",
            "nearby content"
          ]
        },
        {
          "id": "control-post-visibility",
          "question": "Who can see my uploaded content?",
          "answer": "Visibility depends on the post status, account settings, and available privacy controls. Public and published posts may appear in feeds, search, categories, recommendations, and map views.",
          "keywords": [
            "visibility",
            "privacy",
            "public post"
          ]
        },
        {
          "id": "report-post",
          "question": "How do I report a problem with a post?",
          "answer": "Use the report or support option available on the post page. Include the post link, a clear issue description, and screenshots when possible.",
          "keywords": [
            "report",
            "post",
            "moderation"
          ]
        },
        {
          "id": "report-user-comment",
          "question": "How do I report a user or comment?",
          "answer": "Use the reporting control next to the profile, post, or comment. Select the most accurate reason and provide enough context for the moderation team to review the issue.",
          "keywords": [
            "report user",
            "report comment",
            "abuse"
          ]
        },
        {
          "id": "block-user",
          "question": "Can I block another user?",
          "answer": "If blocking is available, open the user’s profile or account menu and select Block. Blocking may limit that user’s ability to interact with you or view certain activity.",
          "keywords": [
            "block",
            "user safety"
          ]
        },
        {
          "id": "personal-information-protection",
          "question": "How can I protect my personal information?",
          "answer": "Avoid sharing sensitive details in your profile, posts, comments, or location fields. Use a strong password, verify your email, review privacy settings, and report suspicious activity.",
          "keywords": [
            "personal data",
            "privacy",
            "security"
          ]
        },
        {
          "id": "youth-safety",
          "question": "What safety guidance is available for younger users?",
          "answer": "Panorra’s Safety Youth resources should explain age-appropriate privacy practices, safe sharing, location awareness, reporting tools, and how parents or guardians can support younger users.",
          "keywords": [
            "youth safety",
            "young users",
            "parents"
          ]
        },
        {
          "id": "remove-location-data",
          "question": "Can I remove location information from a post?",
          "answer": "If post editing is available, remove or update the location before saving. Removing location information may reduce map and nearby discovery for that post.",
          "keywords": [
            "remove location",
            "privacy"
          ]
        },
        {
          "id": "privacy-policy",
          "question": "Where can I read Panorra’s privacy policy?",
          "answer": "Open Helpful Resources in the Help Center and select Privacy Policy to review how Panorra collects, uses, stores, and protects information.",
          "keywords": [
            "privacy policy",
            "data"
          ]
        }
      ]
    },
    {
      "id": "explore-connect",
      "title": "Explore & Connect",
      "description": "Discover content, follow creators, interact with posts, and save favorites.",
