            "likes",
            "engagement"
          ]
        },
        {
          "id": "popular-content",
          "question": "How is popular content determined?",
          "answer": "Popularity may consider likes, comments, bookmarks, followers, recent activity, content quality, and internal relevance or scoring signals.",
